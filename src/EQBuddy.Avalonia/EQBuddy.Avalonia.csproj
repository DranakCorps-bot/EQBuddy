<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EQBuddy.Avalonia</AssemblyName>
    <RootNamespace>EQBuddy.Avalonia</RootNamespace>
    <!-- Version comes from Directory.Build.props (repo root). A hardcoded copy here is
         exactly how issue #30 happened: release.ps1 bumped only the WPF csproj, and the
         Linux tarball shipped identifying as an older version, nagging itself forever. -->

    <ApplicationIcon>..\EQBuddy\Assets\EQBuddy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- EQBuddy Mobile. The server was written UI-toolkit-free from day one precisely so
         this lane could host it (EQBuddy.Companion's own header says so, and
         ArchitectureTests.SharedLayersReferenceNoUiToolkit holds it to that) — but the
         reference itself was never added, so the phone existed only on Windows and #208
         (sbaum23) is a Linux player asking where it went. -->
    <ProjectReference Include="..\EQBuddy.Companion\EQBuddy.Companion.csproj" />
    <ProjectReference Include="..\EQBuddy.Core\EQBuddy.Core.csproj" />
    <ProjectReference Include="..\EQBuddy.UI.Shared\EQBuddy.UI.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\EQBuddy\Assets\tutorial\*.png"
                      Link="Assets\tutorial\%(Filename)%(Extension)" />
    <!-- The real logo for the tray icon (TrayIcon.DrawIcon falls back to a drawn
         disc when a platform can't load it). -->
    <AvaloniaResource Include="..\EQBuddy\Assets\EQBuddy.ico"
                      Link="Assets\EQBuddy.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The headless render tests drive the real widget, which means reaching internals
         (AppTheme, the snapshot-render hook). Test-only: nothing else references this. -->
    <InternalsVisibleTo Include="EQBuddy.Avalonia.Tests" />
  </ItemGroup>

</Project>
