<Window x:Class="EQBuddy.GearLootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQBuddy Gear &amp; Loot" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="520" WindowStartupLocation="Manual">
    <!-- The GEAR & LOOT theme (docs/Themes.md). Named by David on 2026-08-20 over the
         plan's "Loot & Items": it names the two things actually in it.

         Two widget cards — Loot and Gear — become two tabs here and one launcher line on
         the widget. Drops and Item lookup join them in a second pass; they are existing
         windows, and folding four surfaces at once is four chances to lose something
         quietly rather than one.

         Why a window and not an overlay: every question here is one you look AWAY for —
         what did I get, is this an upgrade, where do I farm next. None of it is a
         deadline, so by CLAUDE.md's surface rule none of it earns space over the running
         game. What it earns instead is room to be read.

         ProgressWindow is the template, down to the chrome and the drag/close/zoom
         wiring. Nothing below carries a literal size, radius or spacing value — every
         number resolves out of the token dictionary, and DesignRatchetTests fails the
         build if a literal reappears. -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource CornerPanel}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title row. The icon is a vector (DesignSystem.Icon), never a glyph — emoji
             box outright in the Wine prefixes the Linux and macOS builds run under
             (#148, #166). -->
        <Grid Grid.Row="0" Margin="{DynamicResource PadCard}">
            <StackPanel x:Name="TitleRow" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Button x:Name="CloseBtn" Style="{StaticResource EqIconButton}" ToolTip="Close"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="{DynamicResource PadCard}">
            <!-- Labels, order and keys come from Core's LootSurface, and the badges beside
                 them from UI.Shared's LootTheme, so this window, the Avalonia widget and
                 EQBuddy Mobile cannot end up naming different tabs or reporting different
                 numbers (#184, #210).

                 WRAPS, and it has to. A horizontal StackPanel measures its children with
                 INFINITE width, so nothing ever reaches a boundary to wrap at and the last
                 chip is simply clipped at the panel's edge — silently, with no ellipsis to
                 say so. That is trap 25, and it cost the Progress theme its Raids tab on
                 the first build. Two chips fit today; the second pass makes it four, and
                 the loot badge is a whole sentence ("39 items (+4 made)"). -->
            <WrapPanel x:Name="TabStrip" Margin="{DynamicResource StackS}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" x:Name="BodyScroll" VerticalScrollBarVisibility="Auto"
                      Margin="{DynamicResource PadCard}">
            <!-- The active tab's surface. It carries no Visibility and no Margin of its
                 own: the lifted control owns both (trap 15 — a control that hides itself
                 inside a host that also hides itself has two switches for one state, and
                 only one of them is ever wired). -->
            <ContentControl x:Name="TabBody"/>
        </ScrollViewer>
        <!-- The mini-dashboard star the Loot card header used to carry.
             It HAD to come somewhere. That star is the only writer MiniStats has for
             "loot", and a fold that drops the last writer of a setting is exactly the
             shape of #204/#209, #210 and #212 (CLAUDE.md trap 20) — DeadSettingTests
             would have failed the build, and before that test existed it cost three
             player-facing bugs. Here it gets the words it never had on the widget. -->
        <StackPanel Grid.Row="3" x:Name="MiniRow" Orientation="Horizontal"
                    Margin="{DynamicResource PadCard}" VerticalAlignment="Center"/>
      </Grid>
    </Border>
</Window>
