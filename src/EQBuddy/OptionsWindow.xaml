<Window x:Class="EQBuddy.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQBuddy Options" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        MinWidth="390" MaxWidth="900"
        WindowStartupLocation="Manual">
    <!-- MinWidth was 272, which predated the rule editor's later columns (spell-class
         picker, per-rule sound, delay): below ~390 the Name and Match boxes collapse to a
         character or two. Raising it also widens installs whose saved OptionsWidth was the
         old 340 default, since the width is clamped to MinWidth when the window opens. -->
    <!-- Custom chrome (WindowStyle=None + AllowsTransparency) has no native resize
         border, so width is driven by the drag handles on both edges below.
         SizeToContent stays on Height, but MaxHeight is clamped at runtime to the work
         area of whichever monitor the window is on — at high Windows scaling the content
         is taller than the screen, so the body has to scroll. The title row and the tab
         bar stay outside the scroll so ✕ and navigation are always reachable. -->
    <!-- Tabs since 1.67.0 (David: "a wall of options... needs serious reorganization").
         Hand-rolled nav (text links + one visible panel) rather than a TabControl —
         the custom chrome already fights native control templates, and the sort-link
         idiom is the app's own. Every control kept its x:Name; the code-behind did
         not have to know the furniture moved. -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,6">
            <TextBlock Text="Options" FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource AccentBrush}"/>
            <Button Style="{StaticResource IconButton}" Content="&#x2715;" ToolTip="Close"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
            <TextBlock x:Name="TabLook" Text="Look" Tag="look" FontSize="12" Cursor="Hand"
                       Padding="0,0,0,3" Margin="0,0,14,0" MouseLeftButtonDown="OnTabClick"/>
            <TextBlock x:Name="TabAlerts" Text="Alerts &amp; chips" Tag="alerts" FontSize="12" Cursor="Hand"
                       Padding="0,0,0,3" Margin="0,0,14,0" MouseLeftButtonDown="OnTabClick"/>
            <TextBlock x:Name="TabWatch" Text="Watch rules" Tag="watch" FontSize="12" Cursor="Hand"
                       Padding="0,0,0,3" Margin="0,0,14,0" MouseLeftButtonDown="OnTabClick"/>
            <TextBlock x:Name="TabCards" Text="Cards &amp; windows" Tag="cards" FontSize="12" Cursor="Hand"
                       Padding="0,0,0,3" Margin="0,0,14,0" MouseLeftButtonDown="OnTabClick"/>
            <TextBlock x:Name="TabBehavior" Text="Behavior" Tag="behavior" FontSize="12" Cursor="Hand"
                       Padding="0,0,0,3" MouseLeftButtonDown="OnTabClick"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="16,0,16,16">

        <!-- ============================ LOOK ============================ -->
        <StackPanel x:Name="TabLookPanel">
            <Grid>
                <TextBlock Text="Theme" FontSize="12"/>
                <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Right" Width="130" FontSize="12"
                          SelectionChanged="OnThemeChanged"/>
            </Grid>

            <!-- Rows are built in code (UpdateCustomColorsPanel); visible only while the
                 Custom theme is selected. -->
            <StackPanel x:Name="CustomColorsPanel" Visibility="Collapsed" Margin="0,8,0,0"/>

            <Grid Margin="0,12,0,0">
                <TextBlock Text="Widget size" FontSize="12"/>
                <TextBlock x:Name="ScaleLabel" Text="100%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <Slider x:Name="ScaleSlider" Minimum="0.8" Maximum="1.6" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Margin="0,4,0,12"
                    ValueChanged="OnScaleChanged"/>

            <Grid>
                <TextBlock Text="Chips &amp; alerts size" FontSize="12"
                           ToolTip="Spawn timer chips, mez chips, and the alert banner"/>
                <TextBlock x:Name="ChipScaleLabel" Text="100%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <Slider x:Name="ChipScaleSlider" Minimum="0.8" Maximum="2.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Margin="0,4,0,12"
                    ValueChanged="OnChipScaleChanged"/>

            <Grid>
                <TextBlock Text="Background see-through" FontSize="12"/>
                <TextBlock x:Name="BgOpacityLabel" Text="95%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <TextBlock Text="Only the dark panel fades — text stays sharp." Style="{StaticResource Dim}"/>
            <Slider x:Name="BgOpacitySlider" Minimum="0.15" Maximum="1.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Margin="0,4,0,12"
                    ValueChanged="OnBgOpacityChanged"/>

            <Grid>
                <TextBlock Text="Whole-widget opacity" FontSize="12"/>
                <TextBlock x:Name="OpacityLabel" Text="96%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <TextBlock Text="Fades everything, text included." Style="{StaticResource Dim}"/>
            <Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1.0" TickFrequency="0.02"
                    IsSnapToTickEnabled="True" Margin="0,4,0,4"
                    ValueChanged="OnOpacityChanged"/>

            <CheckBox x:Name="GridOverlayCheck" Margin="0,10,0,0"
                      Checked="OnGridOverlayToggled" Unchecked="OnGridOverlayToggled">
                <TextBlock Text="▦ Grid overlay for aligning your game UI" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="A faint click-through grid over the whole desk — line up your game windows, then toggle it off here or in the right-click menu. Stronger lines every fourth square."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>
            <Grid Margin="20,4,0,0">
                <TextBlock Text="Grid spacing" FontSize="12"/>
                <TextBlock x:Name="GridSpacingLabel" Text="32 px" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <Slider x:Name="GridSpacingSlider" Minimum="16" Maximum="128" TickFrequency="8"
                    IsSnapToTickEnabled="True" Margin="20,4,0,4"
                    ValueChanged="OnGridSpacingChanged"/>

            <CheckBox x:Name="CursorRingCheck" Margin="0,10,0,0"
                      Checked="OnCursorRingToggled" Unchecked="OnCursorRingToggled">
                <TextBlock Text="Cursor ring (never lose your pointer)" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="A soft ring follows your mouse everywhere — click-through, over the game too. Drag its edge to resize it."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <TextBlock Text="Size also scales all text. Changes apply instantly and are saved. Drag either side edge to widen this window."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ======================= ALERTS &amp; CHIPS ======================= -->
        <StackPanel x:Name="TabAlertsPanel" Visibility="Collapsed">
            <Grid>
                <TextBlock Text="Alert sound" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="SoundCombo" Width="120" FontSize="12"
                              SelectionChanged="OnSoundChanged"/>
                    <Button Content="&#x25B6;" Style="{StaticResource IconButton}" FontSize="11"
                            ToolTip="Play the alert sound" Click="OnSoundTest" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,6,0,0">
                <TextBlock Text="Alert volume" FontSize="12"/>
                <TextBlock x:Name="AlertVolumeLabel" Text="100%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <Slider x:Name="AlertVolumeSlider" Minimum="0.1" Maximum="1.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Margin="0,4,0,4"
                    ValueChanged="OnAlertVolumeChanged"/>
            <TextBlock x:Name="SoundFileNote" Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock Text="While Options is open, the ★ alert banner tile is visible — drag it to where alerts should appear. During play it's click-through and never steals focus."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <!-- Speech gets its own volume: the slider above drives only the MediaPlayer
                 that plays sound files — SAPI never saw it, so one slider claiming both
                 would be a lie in whichever direction it didn't reach. -->
            <Grid Margin="0,12,0,0">
                <TextBlock Text="Alert voice" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="VoiceCombo" Width="164" FontSize="12"
                              SelectionChanged="OnVoiceChanged"/>
                    <Button Content="&#x25B6;" Style="{StaticResource IconButton}" FontSize="11"
                            ToolTip="Hear a sample with the current voice, rate and volume"
                            Click="OnVoiceTest" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Used wherever EQBuddy speaks — watch rules with the S toggle, and the slow alert."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <Grid Margin="0,6,0,0">
                <TextBlock Text="Speech rate" FontSize="12"/>
                <TextBlock x:Name="SpeechRateLabel" Text="normal" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <Slider x:Name="SpeechRateSlider" Minimum="-5" Maximum="5" TickFrequency="1"
                    IsSnapToTickEnabled="True" Margin="0,4,0,4"
                    ValueChanged="OnSpeechRateChanged"/>
            <Grid>
                <TextBlock Text="Speech volume" FontSize="12"/>
                <TextBlock x:Name="SpeechVolumeLabel" Text="100%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <Slider x:Name="SpeechVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5"
                    IsSnapToTickEnabled="True" Margin="0,4,0,4"
                    ValueChanged="OnSpeechVolumeChanged"/>

            <CheckBox x:Name="SlowAlertCheck" Margin="0,12,0,0"
                      Checked="OnSlowAlertToggled" Unchecked="OnSlowAlertToggled">
                <TextBlock Text="Slow alert (an attack-speed debuff lands on you)" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="A 🐌 chip shows the slow's % and its counters; hover it for the cure line. A silent 40% slow quietly doubles a fight."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>
            <CheckBox x:Name="SlowSpokenCheck" Margin="20,6,0,0"
                      Checked="OnSlowAlertToggled" Unchecked="OnSlowAlertToggled">
                <TextBlock Text="Speak it when it lands (&quot;Slowed 40 percent&quot;)" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <CheckBox x:Name="SlowRaidOnlyCheck" Margin="20,6,0,0"
                      Checked="OnSlowAlertToggled" Unchecked="OnSlowAlertToggled">
                <TextBlock Text="Only during raids" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="Raids are detected from raid-channel chat — the log's only raid signal. A raid nobody has typed in for 10 minutes counts as over."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="40,2,0,0"/>

            <CheckBox x:Name="BuffExpiringOnlyCheck" Margin="0,12,0,0"
                      Checked="OnBuffDisplayChanged" Unchecked="OnBuffDisplayChanged">
                <TextBlock Text="Buff timers: only show buffs about to fade" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                <TextBlock Text="warn at" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="BuffWarnBox" Width="44" Margin="6,0,6,0" FontSize="12"
                         TextAlignment="Right" LostFocus="OnBuffDisplayChanged"
                         Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>
                <TextBlock Text="seconds left" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
            <TextBlock Text="Unticked, the Buffs card counts down everything that's running. Ticked, it stays quiet (with an honest count) until a buff is inside the warning window — tell me when it matters. Your own casts already include your Spell Casting Reinforcement rank; a buff's first natural fade teaches its exact duration either way."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <TextBlock Text="Buff set — the missing line" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,2"/>
            <TextBlock Text="Pick the buffs this character never camps without — per class: each pick lands in a class bucket, and the live set assembles from the classes you're running plus (any class), so swapping one class keeps the other classes' picks. The ⏳ Buffs card grows one line ONLY when something's off: missing (seen fading, or its timer ran out), expiring (inside the warn window above), or not seen (no landing line this session — it may be up from before EQBuddy was watching; the log can't tell, so it's shown as its own honest state). Everything up = no line at all. You build the list yourself; nothing is ever added for you."
                       Style="{StaticResource Dim}" TextWrapping="Wrap"/>
            <TextBlock x:Name="BuffSetCharNote" Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Margin="0,2,0,0"/>
            <StackPanel x:Name="BuffSetPanel" Margin="0,4,0,0"/>
            <!-- Stage 2 (#120): the add box targets a class bucket. The FULL class list
                 is offered here (unlike the breakout's active-only list) so a swap can
                 be configured in advance. -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="BuffSetClassBox" MinWidth="110" Margin="0,0,6,0" FontSize="12"
                          VerticalAlignment="Center"
                          ToolTip="Which class bucket the next pick goes into — (any class) applies whatever combination you run"/>
                <TextBox Grid.Column="1" x:Name="BuffSetAddBox" Style="{StaticResource InputBox}"
                         TextChanged="OnBuffSetSearchChanged"
                         ToolTip="Type a few letters of a buff's name — buffs you've been seen casting list first, then the whole buff catalog"/>
            </Grid>
            <Popup x:Name="BuffSetPopup" PlacementTarget="{Binding ElementName=BuffSetAddBox}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border x:Name="BuffSetChrome" BorderThickness="1" Padding="2" CornerRadius="6">
                    <ListBox x:Name="BuffSetMatches" MaxHeight="240" MaxWidth="480" FontSize="11.5"
                             SelectionChanged="OnBuffSetMatchPicked"/>
                </Border>
            </Popup>

            <CheckBox x:Name="MezChipsCheck" Margin="0,12,0,0"
                      Checked="OnMezChipsToggled" Unchecked="OnMezChipsToggled">
                <TextBlock Text="Mez countdown chips (who's asleep, wake-up timers)" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="Untick if your class never mezzes — the stack stops appearing entirely."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <CheckBox x:Name="TrackSpawnsCheck" Margin="0,10,0,0"
                      Checked="OnTrackSpawnsToggled" Unchecked="OnTrackSpawnsToggled">
                <TextBlock Text="🕒 Track spawns (named respawn timers)" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="Kill a named — or its placeholder — and a small countdown chicklet appears (⏳ Asaka L`Rei 3:12). Chicklets stack, drag anywhere as one, show every timer you have running in any zone, and flip to DUE for a minute (click to dismiss sooner). Double-click one (or right-click → Spawn timers…) for the full zone list, which follows you zone to zone. We captured the respawn times we could from community sources — if you notice a discrepancy in game, type over the duration: your number wins and survives updates."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <CheckBox x:Name="SpawnGrowUpCheck" Margin="0,10,0,0"
                      Checked="OnChipGrowToggled" Unchecked="OnChipGrowToggled">
                <TextBlock Text="Spawn chips grow upward" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <CheckBox x:Name="MezGrowUpCheck" Margin="0,4,0,0"
                      Checked="OnChipGrowToggled" Unchecked="OnChipGrowToggled">
                <TextBlock Text="Mez chips grow upward" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="A stack normally holds its top edge and grows downward as chips arrive. Grown-upward it holds its BOTTOM edge instead — park boss timers above mez timers and each grows away from the other."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>
        </StackPanel>

        <!-- ========================= WATCH RULES ========================= -->
        <StackPanel x:Name="TabWatchPanel" Visibility="Collapsed">
            <TextBlock Text="Watch loot, kills, skill-ups, deaths, milestones, your spells wearing off, or any text in the log. Match is a case-insensitive substring, e.g. 'mote'. Spell fade rules can pick a whole class (Any crowd control, Charm, Mez, Root, Lull, Stun, HoT) instead of a named spell, needing no match text. Delay holds the alert back that many seconds so it lands as a cue. 🔔 shows a banner; the sound box picks this rule's own sound, so you can tell what happened by ear — 'Default' follows the shared choice on the Alerts tab, 'Off' stays silent, 'Custom…' takes your own .wav/.mp3."
                       Style="{StaticResource Dim}" TextWrapping="Wrap"/>
            <!-- Collapsed by default: the examples answer the questions people actually ask
                 (is "Mote" enough? why isn't my rule matching?) but they're a wall of text
                 for anyone who already knows. -->
            <Button x:Name="GuideToggle" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Style="{StaticResource IconButton}" FontSize="11"
                    Content="▸ Show examples"
                    ToolTip="Worked examples for every rule kind"
                    Click="OnGuideToggled"/>
            <Border x:Name="GuidePanel" Visibility="Collapsed" Margin="0,4,0,2"
                    Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="8,6">
                <StackPanel x:Name="GuideContent"/>
            </Border>
            <!-- Shared-size scope so the header row's Auto columns track the rule rows'. -->
            <StackPanel x:Name="RulesPanel" Margin="0,4,0,0" Grid.IsSharedSizeScope="True"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddRuleBtn" Content="+ Add watch rule" Style="{StaticResource ActionButton}"
                        HorizontalAlignment="Left" FontSize="12" Click="OnAddRule"/>
                <Button x:Name="AddFromLogBtn" Content="+ From a recent log line…" Style="{StaticResource ActionButton}"
                        HorizontalAlignment="Left" FontSize="12" Margin="8,0,0,0" Click="OnAddRuleFromLog"
                        ToolTip="Pick a line that just happened in your log — it becomes a Text rule, no typing. Edit the match afterward to taste."/>
            </StackPanel>
            <Popup x:Name="RecentLinesPopup" PlacementTarget="{Binding ElementName=AddFromLogBtn}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True">
                <Border x:Name="RecentLinesChrome" BorderThickness="1" Padding="2" CornerRadius="6">
                    <StackPanel>
                        <CheckBox x:Name="RecentLinesHideChat" Margin="4,3,4,3"
                                  Checked="OnRecentLinesFilterChanged" Unchecked="OnRecentLinesFilterChanged">
                            <TextBlock Text="Hide chat (say/tell/channels) — combat and system lines only" FontSize="11"
                                       Foreground="{DynamicResource DimBrush}"/>
                        </CheckBox>
                        <ListBox x:Name="RecentLinesList" MaxHeight="300" MaxWidth="560" FontSize="11.5"
                                 SelectionChanged="OnRecentLinePicked"/>
                    </StackPanel>
                </Border>
            </Popup>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ImportBox" Style="{StaticResource InputBox}"
                         ToolTip="Paste a shared watch rule (EQB1.…) from guild chat or Discord — the ⤴ on any rule row makes one"/>
                <Button x:Name="ImportBtn" Grid.Column="1" Content="Import…" Style="{StaticResource ActionButton}"
                        Margin="6,0,0,0" Padding="8,3" Click="OnImportShare"
                        ToolTip="Preview what the pasted share string would add — nothing is added until you confirm"/>
            </Grid>
            <TextBlock x:Name="ImportPreview" Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Margin="0,4,0,0" Visibility="Collapsed"/>
            <Button x:Name="ImportConfirmBtn" Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Left" FontSize="12" Margin="0,4,0,0"
                    Visibility="Collapsed" Click="OnImportConfirm"/>
            <CheckBox x:Name="PinChipsCheck" Margin="0,6,0,0"
                      Checked="OnPinChipsChanged" Unchecked="OnPinChipsChanged">
                <TextBlock Text="📌 Show watch chips in the mini dashboard" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
        </StackPanel>

        <!-- ======================= CARDS &amp; WINDOWS ======================= -->
        <StackPanel x:Name="TabCardsPanel" Visibility="Collapsed">
            <TextBlock Text="Overlay cards" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2"/>
            <TextBlock Text="Every card you leave visible shows on the widget — one with nothing yet says so in a line and fills in as it happens."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,2"/>
            <TextBlock Text="Gear checklist" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,2"/>
            <TextBlock Text="Import the exported shopping-list HTML from EQ Legends Tools, then show it as a checklist in the Gear overlay card."
                       Style="{StaticResource Dim}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="GearToolsBtn" Content="Open EQ Legends Tools" Style="{StaticResource ActionButton}"
                        FontSize="12" Click="OnOpenGearTools"
                        ToolTip="Open the EQ Legends Tools character sheet/shopping-list page"/>
                <Button x:Name="GearImportBtn" Content="Import gear list..." Style="{StaticResource ActionButton}"
                        FontSize="12" Margin="6,0,0,0" Click="OnImportGearChecklist"/>
                <Button x:Name="GearClearBtn" Content="Clear" Style="{StaticResource ActionButton}"
                        FontSize="12" Margin="6,0,0,0" Click="OnClearGearChecklist"/>
            </StackPanel>
            <TextBlock x:Name="GearImportStatus" Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
            <StackPanel x:Name="CardsPanel"/>
            <TextBlock Text="Breakout windows" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,2"/>
            <TextBlock Text="Which floating windows may open while minimized (each still needs its ⭐ star — or a 📌 pinned rule for Watch). Unticking one here is the same as its ✕."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,2"/>
            <WrapPanel x:Name="BreakoutsPanel"/>

            <CheckBox x:Name="DoubleClickChipsCheck" Margin="0,10,0,0"
                      Checked="OnDoubleClickChipsToggled" Unchecked="OnDoubleClickChipsToggled">
                <TextBlock Text="Double-click a mini-pill chip to open/close its breakout" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="With this on, double-click the 🎒 Loot, ⚔ dps, ✚ hps, 🐾 pet or 🎯 watch chip to pop its window up or dismiss it — and closing one with its ✕ stays quiet, since a double-click brings it right back."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,2"/>

            <CheckBox x:Name="TargetDropsCheck" Margin="0,12,0,0"
                      Checked="OnTargetDropsToggled" Unchecked="OnTargetDropsToggled">
                <TextBlock Text="🎯 Show target drops in the Loot card" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="While you fight, the Loot card lists what the creature can drop (eqlwiki) with your own observed counts this session. Hover an item for its stats; click for full info."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <Grid Margin="0,12,0,0">
                <TextBlock Text="Recent-rate window" FontSize="12"/>
                <ComboBox x:Name="WindowCombo" HorizontalAlignment="Right" Width="90" FontSize="12"
                          SelectionChanged="OnWindowChanged"/>
            </Grid>
            <TextBlock Text='The "Last Xm" figures on Combat, Kills, Money, and Progress.'
                       Style="{StaticResource Dim}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ========================== BEHAVIOR ========================== -->
        <StackPanel x:Name="TabBehaviorPanel" Visibility="Collapsed">
            <!-- FIRST in the tab, not buried at the bottom — the primary way in is the
                 title-bar 📱 button; this is the explanation that sits beside it. -->
            <StackPanel x:Name="SecondScreenBlock" Margin="0,0,0,14">
                <TextBlock Text="EQBuddy Mobile (Beta)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Show EQBuddy on a phone or tablet on your Wi-Fi: scan the code once, then pick which windows that device shows. LAN-only and off by default — nothing leaves your network. The 📱 button in the title bar opens it any time."
                           Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                <Button x:Name="SecondScreenBtn" Content="EQBuddy Mobile…" Style="{StaticResource ActionButton}"
                        HorizontalAlignment="Left" Click="OnSecondScreen"/>
            </StackPanel>
            <CheckBox x:Name="HideUnfocusedCheck"
                      Checked="OnHideUnfocusedToggled" Unchecked="OnHideUnfocusedToggled">
                <TextBlock Text="Hide the widget while the game is running but not focused" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="Alt-tab to a browser and the widget (and its chips and breakout windows) gets out of the way; alt-tab back to the game and everything returns. This one always shows the widget when the game isn't running — the next box covers that."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <CheckBox x:Name="HideNotRunningCheck" Margin="0,8,0,0"
                      Checked="OnHideNotRunningToggled" Unchecked="OnHideNotRunningToggled">
                <TextBlock Text="Hide the widget while the game isn't running at all" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="The overlay exists only while you play: quit the game and everything disappears, launch it and everything returns (within a few seconds). Need it back without the game — say, to browse session history? Launch EQBuddy again from the Start menu: the running copy surfaces, and stays visible while any of its windows has focus."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <CheckBox x:Name="KeepAboveCheck" Margin="0,10,0,0"
                      Checked="OnKeepAboveToggled" Unchecked="OnKeepAboveToggled">
                <TextBlock Text="Keep EQBuddy above fullscreen overlays (Lossless Scaling and kin)" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="Overlay apps created after EQBuddy land above it in Windows' always-on-top pile, hiding the widget; this quietly re-lifts every EQBuddy window every few seconds. Untick if your screen-capture setup shows the widget twice (a real copy plus the captured one)."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <TextBlock Text="Global hotkeys" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,0"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Nothing is bound until you bind it. A bound key is claimed system-wide while EQBuddy runs — it will stop reaching the game and every other app — so pick combos nothing else uses (Ctrl+Alt+… is usually safe). Click a box, press your keys; ✕ unbinds."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,4"/>
            <StackPanel x:Name="HotkeysPanel" Margin="0,2,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Regen heals about" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="RegenPerTickBox" Width="48" Margin="6,0,6,0" FontSize="12"
                         TextAlignment="Right" LostFocus="OnRegenPerTickChanged"
                         Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>
                <TextBlock Text="hp per tick (blank = wiki base)" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
            <TextBlock Text="Hymn of Restoration and similar regen ticks never log an amount, so their healing is estimated. The wiki knows the unamplified base (Hymn: 9), but instruments and ranks raise the real number — read yours off the heal text over your head and type it here. Your number wins."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <CheckBox x:Name="TruncateCheck" Margin="0,12,0,0"
                      Checked="OnTruncateChanged" Unchecked="OnTruncateChanged">
                <TextBlock Text="Auto-empty finished-session logs" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="Turn off if you use GINA/GamParse or upload your log files elsewhere — they will grow forever, so clean them up yourself occasionally. (Cleanup already stands down whenever the game, GINA, or GamParse is running.)"
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>
            <CheckBox x:Name="ArchiveCheck" Margin="20,6,0,0"
                      Checked="OnArchiveChanged" Unchecked="OnArchiveChanged">
                <TextBlock Text="Keep a timestamped copy before emptying (Logs\archive)" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="On by default: each finished session is saved as eqlog_name_server_YYYYMMDDHHMMSS.txt — the stamp is when the session ended — and Reset session splits the log here rather than letting it run on. Archives are yours to keep or clean up; EQBuddy never deletes them. Untick if you would rather have the disk space back."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="40,2,0,0"/>
            <TextBlock Text="Each finished session is saved as eqlog_name_server_YYYYMMDDHHMMSS.txt — the stamp is when the session ended. Archives are yours to keep or clean up; EQBuddy never deletes them."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="40,2,0,0"/>

            <CheckBox x:Name="TutorialCheck" Margin="0,10,0,0"
                      Checked="OnTutorialToggled" Unchecked="OnTutorialToggled">
                <TextBlock Text="Show quick tutorial at launch" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>

            <CheckBox x:Name="PerfStatsCheck" Margin="0,10,0,0"
                      Checked="OnPerfStatsToggled" Unchecked="OnPerfStatsToggled">
                <TextBlock Text="Show EQBuddy's own CPU &amp; memory in the title bar" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="A small dim readout (&quot;0.3% · 84 MB&quot;) refreshed every few seconds — CPU is the share of ALL cores. Diagnostic honesty: if EQBuddy ever hogs your machine, this is how you catch it and tell us."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

        </StackPanel>

        </Grid>
        </ScrollViewer>

        <!-- Width handles on both edges. Transparent template so they read as bare edges;
             the cursor is the affordance. Dragging the left edge moves Left as well as
             Width so the right edge stays put. Width is persisted on release. -->
        <Thumb x:Name="LeftGrip" Grid.RowSpan="3" Width="8"
               HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Cursor="SizeWE" ToolTip="Drag to resize"
               DragStarted="OnResizeStarted" DragDelta="OnResizeLeftDelta"
               DragCompleted="OnResizeCompleted">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
          </Thumb.Template>
        </Thumb>

        <Thumb x:Name="RightGrip" Grid.RowSpan="3" Width="8"
               HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Cursor="SizeWE" ToolTip="Drag to resize"
               DragStarted="OnResizeStarted" DragDelta="OnResizeRightDelta"
               DragCompleted="OnResizeCompleted">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
          </Thumb.Template>
        </Thumb>
      </Grid>
    </Border>
</Window>
