<Window x:Class="EQBuddy.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQBuddy Options" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        MinWidth="390" MaxWidth="900"
        WindowStartupLocation="Manual">
    <!-- MinWidth was 272, which predated the rule editor's later columns (spell-class
         picker, per-rule sound, delay): below ~390 the Name and Match boxes collapse to a
         character or two. Raising it also widens installs whose saved OptionsWidth was the
         old 340 default, since the width is clamped to MinWidth when the window opens. -->
    <!-- Custom chrome (WindowStyle=None + AllowsTransparency) has no native resize
         border, so width is driven by the drag handles on both edges below.
         SizeToContent stays on Height, but MaxHeight is clamped at runtime to the work
         area of whichever monitor the window is on — at high Windows scaling the content
         is taller than the screen, so the body has to scroll. The title row and the tab
         bar stay outside the scroll so ✕ and navigation are always reachable. -->
    <!-- Tabs since 1.67.0 (David: "a wall of options... needs serious reorganization").
         Hand-rolled nav (text links + one visible panel) rather than a TabControl —
         the custom chrome already fights native control templates, and the sort-link
         idiom is the app's own. Every control kept its x:Name; the code-behind did
         not have to know the furniture moved. -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,6">
            <TextBlock Text="Options" FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource AccentBrush}"/>
            <Button Style="{StaticResource IconButton}" Content="&#x2715;" ToolTip="Close"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
            <TextBlock x:Name="TabLook" Text="Look" Tag="look" FontSize="12" Cursor="Hand"
                       Padding="0,0,0,3" Margin="0,0,14,0" MouseLeftButtonDown="OnTabClick"/>
            <TextBlock x:Name="TabAlerts" Text="Alerts &amp; chips" Tag="alerts" FontSize="12" Cursor="Hand"
                       Padding="0,0,0,3" Margin="0,0,14,0" MouseLeftButtonDown="OnTabClick"/>
            <TextBlock x:Name="TabWatch" Text="Watch rules" Tag="watch" FontSize="12" Cursor="Hand"
                       Padding="0,0,0,3" Margin="0,0,14,0" MouseLeftButtonDown="OnTabClick"/>
            <TextBlock x:Name="TabCards" Text="Cards &amp; windows" Tag="cards" FontSize="12" Cursor="Hand"
                       Padding="0,0,0,3" Margin="0,0,14,0" MouseLeftButtonDown="OnTabClick"/>
            <TextBlock x:Name="TabBehavior" Text="Behavior" Tag="behavior" FontSize="12" Cursor="Hand"
                       Padding="0,0,0,3" MouseLeftButtonDown="OnTabClick"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Grid Margin="16,0,16,16">

        <!-- ============================ LOOK ============================
             EMPTY BY DESIGN since SR-1, but for one line. The theme picker, the Custom
             colour rows, the four size/opacity sliders, the alignment grid and the cursor
             ring are built by SettingsLookView and added to the bare host below, in the
             arrangement players already have, from a block the Evolved shell's Settings
             room will compose under its own Look tab.

             The host carries no Margin and no state of its own (trap 15): the Visibility
             on this panel belongs to this window's tab machinery, which SelectTab drives
             and no block knows about.

             THE ONE SENTENCE THAT DID NOT LIFT is the last one — it is about THIS window's
             resize grips, which a shell room does not have, so it stays declared beside
             them rather than travelling to a host where it would be false (trap 37: when
             you lift a view out, list what each row of the grid was buying). -->
        <StackPanel x:Name="TabLookPanel">
            <StackPanel x:Name="LookBlockHost"/>
            <TextBlock Text="Drag either side edge to widen this window."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ======================= ALERTS &amp; CHIPS =======================
             EMPTY BY DESIGN since SR-4. The shared sound/voice/volume/rate header and
             the Buffs, Spawns and Crowd blocks are built by SettingsAlertsView and
             added here in code, in AlertSurface's order — the arrangement players
             already have, from blocks the Evolved shell's Settings room will compose
             under the four AlertSurface tabs.

             The host carries no Margin and no state of its own (trap 15): the
             Visibility below belongs to this window's tab machinery, which SelectTab
             drives and no block knows about. Every control that used to be declared
             here now lives in that file, and the trap-26 enumeration of where each one
             went rides the PR. -->
        <StackPanel x:Name="TabAlertsPanel" Visibility="Collapsed"/>

        <!-- ========================= WATCH RULES =========================
             Wholly SettingsAlertsView's Watch block now, built into the bare host below.

             The tab used to declare ONE extra row beneath it: PinChipsCheck, the
             "Show watch chips in the mini dashboard" master. It RETIRED in Surface A /
             SA-R — it and the per-rule 📌 on every rule row both answered "does this
             chip show", and Helm's #341 sign was one switch, not two. The pin is the
             survivor, it is inside the block, and it is the one the Evolved shell's
             Alerts tab carries too. WatchPinMigration translates an unticked master
             into per-rule unpins once, so nobody's bar changes under them.

             The host carries no Margin and no state of its own (trap 15). -->
        <StackPanel x:Name="TabWatchPanel" Visibility="Collapsed">
            <StackPanel x:Name="WatchBlockHost"/>
        </StackPanel>

        <!-- ======================= CARDS &amp; WINDOWS =======================
             EMPTY BY DESIGN since SR-3. The card list and its "no longer on the widget"
             companion, the mini-dashboard tick boxes, the floating-window tick boxes and
             the three switches that had accumulated under them (double-click-a-chip,
             target drops, the recent-rate picker) are all built by SettingsHudView and
             added to this bare host in code — the arrangement players already have, from
             a block the Evolved shell's Settings room composes under the tab name "HUD".

             THE TAB LABEL HERE DOES NOT CHANGE, and that is signed rather than an
             oversight (Bevel I-11 §3): the terminology ban's own scope line exempts v1
             OptionsWindow, and renaming shipped v1 copy for no player benefit is the #228
             class. The HEADINGS inside did change — they are the block's, said once, and
             the block serves a host the ban does apply to.

             The host carries no Margin and no state of its own (trap 15): the Visibility
             below belongs to this window's tab machinery, which SelectTab drives and no
             block knows about. -->
        <StackPanel x:Name="TabCardsPanel" Visibility="Collapsed"/>

        <!-- ========================== BEHAVIOR ==========================
             EMPTY BY DESIGN since SR-1. EQBuddy Mobile's pairing panel and its sounds
             switch, the three hide-when rules and the Alt+Tab note, keep-above, the
             global hotkey rows, the regen override, auto-empty + archive, the tutorial
             toggle and the perf readout are all built by SettingsBehaviorView and added
             to this bare host in code — the arrangement players already have, from a
             block the Evolved shell's Settings room will compose under its own Behavior
             tab.

             The host carries no Margin and no state of its own (trap 15): the Visibility
             below belongs to this window's tab machinery, which SelectTab drives and no
             block knows about.

             The one thing the WINDOW still does for this block is ROUTE a key press to
             it — see OnPreviewKeyDown. A recorder rebuilds its own row on click, so
             nothing inside this panel has focus when the gesture arrives. -->
        <StackPanel x:Name="TabBehaviorPanel" Visibility="Collapsed"/>

        </Grid>
        </ScrollViewer>

        <!-- Width handles on both edges. Transparent template so they read as bare edges;
             the cursor is the affordance. Dragging the left edge moves Left as well as
             Width so the right edge stays put. Width is persisted on release. -->
        <Thumb x:Name="LeftGrip" Grid.RowSpan="3" Width="8"
               HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Cursor="SizeWE" ToolTip="Drag to resize"
               DragStarted="OnResizeStarted" DragDelta="OnResizeLeftDelta"
               DragCompleted="OnResizeCompleted">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
          </Thumb.Template>
        </Thumb>

        <Thumb x:Name="RightGrip" Grid.RowSpan="3" Width="8"
               HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Cursor="SizeWE" ToolTip="Drag to resize"
               DragStarted="OnResizeStarted" DragDelta="OnResizeRightDelta"
               DragCompleted="OnResizeCompleted">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
          </Thumb.Template>
        </Thumb>
      </Grid>
    </Border>
</Window>
