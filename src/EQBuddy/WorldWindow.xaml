<Window x:Class="EQBuddy.WorldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQBuddy World" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        Width="640" WindowStartupLocation="Manual">
    <!-- The WORLD theme (docs/Themes.md theme 6; FABLE.md World plan PR 2). Four
         standalone windows — MapWindow, SpawnsWindow, TravelWindow, plus the buried
         "Drop camp marker" cog entry — become one window with four tabs: Map · Camps ·
         Path · Travels. CreatureWindow is the template, down to the chrome and the
         drag/close/zoom wiring.

         Each tab's surface is this window's OWN instance (World PR 1's factories on
         MainWindow) — never borrowed (trap 45: a UIElement has one parent).

         The Drop-marker action (Helm-signed, World pre-design amendment) lives in the
         chrome row below the body — visible on every tab, not just Travels, so the
         capability never loses its home for even one release once the cog entry retires.

         Nothing below carries a literal size, radius or spacing value — every number
         resolves out of the token dictionary, and DesignRatchetTests fails the build if a
         literal reappears. -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource CornerPanel}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title row. The icon is a vector (DesignSystem.Icon), never a glyph — emoji
             box outright in the Wine prefixes the Linux and macOS builds run under
             (#148, #166). -->
        <Grid Grid.Row="0" Margin="{DynamicResource PadCard}">
            <StackPanel x:Name="TitleRow" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Button x:Name="CloseBtn" Style="{StaticResource EqIconButton}" ToolTip="Close"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="{DynamicResource PadCard}">
            <!-- Labels, order and keys come from Core's WorldSurface, so this window, the
                 Avalonia widget and EQBuddy Mobile cannot end up naming different tabs.

                 WRAPS, and it has to. A horizontal StackPanel measures its children with
                 INFINITE width, so nothing ever reaches a boundary to wrap at and the last
                 chip is simply clipped at the panel's edge — trap 25. -->
            <WrapPanel x:Name="TabStrip" Margin="{DynamicResource StackS}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" x:Name="BodyScroll" VerticalScrollBarVisibility="Auto"
                      Margin="{DynamicResource PadCard}">
            <!-- The active tab's surface. It carries no Visibility and no Margin of its
                 own: the lifted control owns both (trap 15). -->
            <ContentControl x:Name="TabBody"/>
        </ScrollViewer>

        <!-- The Drop-marker action (Helm-signed World pre-design amendment, question 6):
             window chrome on every tab, so it survives the cog entry's retirement without
             losing its home for even one release. -->
        <StackPanel Grid.Row="3" x:Name="ActionRow" Orientation="Horizontal"
                    Margin="{DynamicResource PadCard}" VerticalAlignment="Center"/>
      </Grid>
    </Border>
</Window>
