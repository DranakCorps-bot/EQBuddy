<Window x:Class="EQBuddy.BreakoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EQBuddy"
        SizeToContent="Height" Width="272" MinWidth="200" MinHeight="90"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="CanResize" WindowStartupLocation="Manual">
    <Border x:Name="Chrome" CornerRadius="{DynamicResource CornerPanel}" BorderThickness="1" Padding="{DynamicResource PadBreakout}"
            MouseLeftButtonDown="OnDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Its own column rather than a StackPanel with the title: the title
                     TRIMS, and a stack measures with infinite width so trimming would
                     never fire and the text would run under the buttons (trap 14). -->
                <local:EqIcon x:Name="TitleIcon" Glyph="Info" Size="12"
                              VerticalAlignment="Center" Margin="{DynamicResource GapS}"/>
                <TextBlock Grid.Column="1" x:Name="TitleText" FontSize="{DynamicResource FontTitleSection}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <!-- Damage kind only (#102, jeremycranfill): the Combat card's ⧉ fight
                     export, reachable without leaving the minimized view. -->
                <local:EqIcon Grid.Column="2" x:Name="CopyFight" Glyph="Copy" Size="11"
                           VerticalAlignment="Center" Cursor="Hand" Margin="{DynamicResource FlankXs}"
                           Visibility="Collapsed" MouseLeftButtonDown="OnCopyFight"
                           Ink="DimBrush"
                           ToolTip="Copy the last fight as Discord-ready text (a monospace block — the official Discord blocks images, so the parse travels as text). Your numbers only, from your log."/>
                <local:EqIcon Grid.Column="3" x:Name="OpenTimeline" Glyph="Timeline" Size="11"
                           VerticalAlignment="Center" Cursor="Hand" Margin="{DynamicResource FlankXs}"
                           Visibility="Collapsed" MouseLeftButtonDown="OnOpenTimeline"
                           Ink="DimBrush"
                           ToolTip="Fight timeline: the whole pull, a lane per skill — every hit, miss and resist, plus DPS over time."/>
                <!-- Filled in code with the compact segmented strip — the same control
                     the Loot strips use, so the highlight is rounded inside this
                     border's own rounding (LW, 2026-08-18: the old square TextBlock
                     wash poked outside the pill).
                     Rebase note: LW's branch predates this file joining
                     DesignRatchetTests.Migrated, so its literal 6 / 6,0,6,0 are the
                     token resources here. Same geometry, held to the scale. -->
                <Border Grid.Column="4" x:Name="ScopeBorder" CornerRadius="{DynamicResource CornerCard}" BorderThickness="1"
                        Margin="{DynamicResource FlankS}" VerticalAlignment="Center">
                    <StackPanel x:Name="ScopeHost" Orientation="Horizontal"/>
                </Border>
                <local:EqIcon Grid.Column="5" Glyph="Close" Size="11" VerticalAlignment="Center"
                           Cursor="Hand" Margin="{DynamicResource FlankXxs}" MouseLeftButtonDown="OnDismiss"
                           ToolTip="Hide this window for good (its star chip stays; re-enable under Options → Breakout windows)"/>
            </Grid>
            <TextBlock Grid.Row="1" x:Name="SubText" FontSize="{DynamicResource FontMetadata}" Margin="{DynamicResource RowTightLeft}"
                       TextTrimming="CharacterEllipsis"/>
            <!-- Sort links for the stat kinds (damage/healing/pet), same metrics as the
                 main cards; hidden for Watch and Loot, whose rows aren't ability stats. -->
            <StackPanel Grid.Row="2" x:Name="SortBar" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="{DynamicResource GripInset}">
                <TextBlock Text="sort:" FontSize="{DynamicResource FontMetadata}" Margin="{DynamicResource GapXs}"
                           Foreground="{DynamicResource DimBrush}"/>
                <TextBlock x:Name="SortTotal" Text="total" FontSize="{DynamicResource FontMetadata}" Cursor="Hand"
                           Tag="total" MouseLeftButtonDown="OnSortClick" Margin="{DynamicResource GapS}"/>
                <TextBlock x:Name="SortHits" Text="hits" FontSize="{DynamicResource FontMetadata}" Cursor="Hand"
                           Tag="hits" MouseLeftButtonDown="OnSortClick" Margin="{DynamicResource GapS}"/>
                <TextBlock x:Name="SortAvg" Text="avg" FontSize="{DynamicResource FontMetadata}" Cursor="Hand"
                           Tag="avg" MouseLeftButtonDown="OnSortClick" Margin="{DynamicResource GapS}"/>
                <TextBlock x:Name="SortRate" Text="dps" FontSize="{DynamicResource FontMetadata}" Cursor="Hand"
                           Tag="rate" MouseLeftButtonDown="OnSortClick"/>
            </StackPanel>
            <!-- Loot Session scope only: show all / looted / other on the left and the
                 count / name / recent order on the right, writing the same two settings
                 the main Loot card reads so the two surfaces stay in lockstep. Built in
                 code by LootBreakoutView (Gate 4) out of the app's EqSegmentedStrip: it
                 was two hand-built strips of TextBlocks with Tags, which is what #198 had
                 to write because the primitive was private to one window. -->
            <ContentControl Grid.Row="2" x:Name="LootStrips"/>
            <ScrollViewer Grid.Row="3" x:Name="RowsScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel>
                    <ItemsControl x:Name="Rows"/>
                    <TextBlock x:Name="EmptyText" FontSize="{DynamicResource FontCaption}" Margin="1,1,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
            <!-- Buffs kind only (#120 stage 2, Frankthetankk): the in-place editor —
                 pick a class bucket, type a buff, done, no Options round-trip. Same
                 seen-first search the Options editor uses (BuffSetSearch). -->
            <Grid Grid.Row="4" x:Name="BuffEditor" Visibility="Collapsed" Margin="{DynamicResource LeadXs}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="BuffClassBox" FontSize="{DynamicResource FontCaption}" MinWidth="90" Margin="{DynamicResource GapS}"
                          VerticalAlignment="Center"
                          ToolTip="Which class bucket the next pick goes into — (any class) applies whatever combination you run"/>
                <TextBox Grid.Column="1" x:Name="BuffAddBox" FontSize="{DynamicResource FontBodySecondary}"
                         Style="{DynamicResource InputBox}"
                         TextChanged="OnBuffSearchChanged"
                         ToolTip="Type a few letters of a buff — buffs you've been seen casting list first, then the whole catalog"/>
                <Popup x:Name="BuffPopup" PlacementTarget="{Binding ElementName=BuffAddBox}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border x:Name="BuffPopupChrome" BorderThickness="1" Padding="{DynamicResource PadXxs}" CornerRadius="{DynamicResource CornerCard}">
                        <ListBox x:Name="BuffMatches" MaxHeight="200" MaxWidth="360" FontSize="{DynamicResource FontBodySecondary}"
                                 SelectionChanged="OnBuffMatchPicked"/>
                    </Border>
                </Popup>
            </Grid>
            <!-- No native border on a frameless window, so this grip is the resize story
                 (same Thumb idiom the Options width grips use). Drag = take manual control
                 of the size (persisted, content scrolls); double-click = back to auto. -->
            <Thumb Grid.Row="3" x:Name="SizeGrip" Width="14" Height="14"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Margin="0,0,-4,-5"
                   DragDelta="OnGripDrag" DragCompleted="OnGripDone"
                   MouseDoubleClick="OnGripReset"
                   ToolTip="Drag to resize (list scrolls) — double-click to auto-size again">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <local:EqIcon Glyph="Expand" Size="11" Opacity="0.75"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Background="Transparent" Padding="{DynamicResource InsetXxsLeft}"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
