<Window x:Class="EQBuddy.BreakoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="272" MinWidth="200" MinHeight="90"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="CanResize" WindowStartupLocation="Manual">
    <Border x:Name="Chrome" CornerRadius="12" BorderThickness="1" Padding="10,7,10,9"
            MouseLeftButtonDown="OnDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontSize="12.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Damage kind only (#102, jeremycranfill): the Combat card's ⧉ fight
                     export, reachable without leaving the minimized view. -->
                <TextBlock Grid.Column="1" x:Name="CopyFight" Text="⧉" FontSize="11"
                           VerticalAlignment="Center" Cursor="Hand" Padding="4,0"
                           Visibility="Collapsed" MouseLeftButtonDown="OnCopyFight"
                           Foreground="{DynamicResource DimBrush}"
                           ToolTip="Copy the last fight as Discord-ready text (a monospace block — the official Discord blocks images, so the parse travels as text). Your numbers only, from your log."/>
                <TextBlock Grid.Column="2" x:Name="OpenTimeline" Text="⧗" FontSize="11"
                           VerticalAlignment="Center" Cursor="Hand" Padding="4,0"
                           Visibility="Collapsed" MouseLeftButtonDown="OnOpenTimeline"
                           Foreground="{DynamicResource DimBrush}"
                           ToolTip="Fight timeline: the whole pull, a lane per skill — every hit, miss and resist, plus DPS over time."/>
                <Border Grid.Column="3" x:Name="ScopeBorder" CornerRadius="6" BorderThickness="1"
                        Margin="6,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ScopeFight" Text="Fight" FontSize="10" Padding="7,1"
                                   Cursor="Hand" MouseLeftButtonDown="OnScopeFight"/>
                        <TextBlock x:Name="ScopeSession" Text="Session" FontSize="10" Padding="7,1"
                                   Cursor="Hand" MouseLeftButtonDown="OnScopeSession"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="4" Text="✕" FontSize="11" VerticalAlignment="Center"
                           Cursor="Hand" Padding="2,0" MouseLeftButtonDown="OnDismiss"
                           ToolTip="Hide this window for good (its ⭐ chip stays; re-enable under ⚙ Options → Breakout windows)"/>
            </Grid>
            <TextBlock Grid.Row="1" x:Name="SubText" FontSize="10.5" Margin="1,0,0,2"
                       TextTrimming="CharacterEllipsis"/>
            <!-- Sort links for the stat kinds (damage/healing/pet), same metrics as the
                 main cards; hidden for Watch and Loot, whose rows aren't ability stats. -->
            <StackPanel Grid.Row="2" x:Name="SortBar" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,0,2,3">
                <TextBlock Text="sort:" FontSize="10" Margin="0,0,4,0"
                           Foreground="{DynamicResource DimBrush}"/>
                <TextBlock x:Name="SortTotal" Text="total" FontSize="10" Cursor="Hand"
                           Tag="total" MouseLeftButtonDown="OnSortClick" Margin="0,0,6,0"/>
                <TextBlock x:Name="SortHits" Text="hits" FontSize="10" Cursor="Hand"
                           Tag="hits" MouseLeftButtonDown="OnSortClick" Margin="0,0,6,0"/>
                <TextBlock x:Name="SortAvg" Text="avg" FontSize="10" Cursor="Hand"
                           Tag="avg" MouseLeftButtonDown="OnSortClick" Margin="0,0,6,0"/>
                <TextBlock x:Name="SortRate" Text="dps" FontSize="10" Cursor="Hand"
                           Tag="rate" MouseLeftButtonDown="OnSortClick"/>
            </StackPanel>
            <!-- Loot Session scope only: the same Count / Name / Recent sorts as the main
                 Loot card, sharing _settings.LootSort so both surfaces agree. Recent is the
                 run-collapsing arrival view (RawLootView) — the reason a rare drop no longer
                 hides behind a common one, and why this view stops lagging new drops. -->
            <StackPanel Grid.Row="2" x:Name="LootSortBar" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,0,2,3" Visibility="Collapsed">
                <TextBlock Text="sort:" FontSize="10" Margin="0,0,4,0"
                           Foreground="{DynamicResource DimBrush}"/>
                <TextBlock x:Name="LootSortCount" Text="count" FontSize="10" Cursor="Hand"
                           Tag="count" MouseLeftButtonDown="OnLootSortClick" Margin="0,0,6,0"/>
                <TextBlock x:Name="LootSortName" Text="name" FontSize="10" Cursor="Hand"
                           Tag="name" MouseLeftButtonDown="OnLootSortClick" Margin="0,0,6,0"/>
                <TextBlock x:Name="LootSortRecent" Text="recent" FontSize="10" Cursor="Hand"
                           Tag="recent" MouseLeftButtonDown="OnLootSortClick"/>
            </StackPanel>
            <!-- Loot Session scope only: show all / looted (incl. forage) / made, the same
                 slice toggle as the main Loot card, sharing _settings.LootView. Left edge of
                 the same row the sort links right-align in. -->
            <StackPanel Grid.Row="2" x:Name="LootViewBar" Orientation="Horizontal"
                        HorizontalAlignment="Left" Margin="0,0,2,3" Visibility="Collapsed">
                <TextBlock Text="show:" FontSize="10" Margin="0,0,4,0"
                           Foreground="{DynamicResource DimBrush}"/>
                <TextBlock x:Name="LootViewAll" Text="all" FontSize="10" Cursor="Hand"
                           Tag="all" MouseLeftButtonDown="OnLootViewClick" Margin="0,0,6,0"/>
                <TextBlock x:Name="LootViewLooted" Text="looted" FontSize="10" Cursor="Hand"
                           Tag="looted" MouseLeftButtonDown="OnLootViewClick" Margin="0,0,6,0"/>
                <TextBlock x:Name="LootViewOther" Text="other" FontSize="10" Cursor="Hand"
                           Tag="other" MouseLeftButtonDown="OnLootViewClick"/>
            </StackPanel>
            <ScrollViewer Grid.Row="3" x:Name="RowsScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel>
                    <ItemsControl x:Name="Rows"/>
                    <TextBlock x:Name="EmptyText" FontSize="11" Margin="1,1,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
            <!-- Buffs kind only (#120 stage 2, Frankthetankk): the in-place editor —
                 pick a class bucket, type a buff, done, no Options round-trip. Same
                 seen-first search the Options editor uses (BuffSetSearch). -->
            <Grid Grid.Row="4" x:Name="BuffEditor" Visibility="Collapsed" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="BuffClassBox" FontSize="11" MinWidth="90" Margin="0,0,5,0"
                          VerticalAlignment="Center"
                          ToolTip="Which class bucket the next pick goes into — (any class) applies whatever combination you run"/>
                <TextBox Grid.Column="1" x:Name="BuffAddBox" FontSize="11.5"
                         Style="{DynamicResource InputBox}"
                         TextChanged="OnBuffSearchChanged"
                         ToolTip="Type a few letters of a buff — buffs you've been seen casting list first, then the whole catalog"/>
                <Popup x:Name="BuffPopup" PlacementTarget="{Binding ElementName=BuffAddBox}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border x:Name="BuffPopupChrome" BorderThickness="1" Padding="2" CornerRadius="6">
                        <ListBox x:Name="BuffMatches" MaxHeight="200" MaxWidth="360" FontSize="11.5"
                                 SelectionChanged="OnBuffMatchPicked"/>
                    </Border>
                </Popup>
            </Grid>
            <!-- No native border on a frameless window, so this grip is the resize story
                 (same Thumb idiom the Options width grips use). Drag = take manual control
                 of the size (persisted, content scrolls); double-click = back to auto. -->
            <Thumb Grid.Row="3" x:Name="SizeGrip" Width="14" Height="14"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Margin="0,0,-4,-5"
                   DragDelta="OnGripDrag" DragCompleted="OnGripDone"
                   MouseDoubleClick="OnGripReset"
                   ToolTip="Drag to resize (list scrolls) — double-click to auto-size again">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <TextBlock Text="⤡" FontSize="13" Opacity="0.75"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Background="Transparent" Padding="2,0,0,0"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
