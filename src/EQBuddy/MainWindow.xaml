<Window x:Class="EQBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EQBuddy"
        Title="EQBuddy" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize">

    <!-- WindowStyle=None + AllowsTransparency means there's no native resize border, so
         ResizeGrip below drives UiScale (not Width/Height directly) from drag distance —
         SizeToContent="WidthAndHeight" then grows or shrinks the window to fit the
         rescaled content, the same way the Options "Widget size" slider already does. -->
    <Grid>
    <Border x:Name="RootBorderElement" Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource CornerPanel}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
        <Border.ContextMenu>
            <!-- Reorganized 1.67.1 (David: the flat twenty-item list needed shelves like
                 Options got). Windows lead — they're the daily drivers — then the two
                 in-play actions, then submenus for data chores and help. Set-and-forget
                 toggles (track spawns, grid overlay, cursor ring) moved to Options tabs;
                 click-through stays, because flipping it mid-pull is what it's FOR. -->
            <ContextMenu>
                <MenuItem Header="Options…" Click="OnOptions"
                          ToolTip="Size, theme, alerts, watch rules, cards, hotkeys — now in tabs"/>
                <Separator/>
                <!-- First in the windows list because it is the one you reach for at the
                     start of a session, not a setting you visit once. -->
                <MenuItem x:Name="MobileMenuItem" Header="EQBuddy Mobile (Beta)…" Click="OnCompanion"
                          ToolTip="Show EQBuddy on a phone or tablet on your Wi-Fi — scan the code, pick which windows that device shows. LAN-only; nothing leaves your network."/>
                <MenuItem Header="Zone map…" Click="OnZoneMap"
                          ToolTip="Your zone's map with your last /log position — type /loc in game to update the marker"/>
                <MenuItem Header="Travel route…" Click="OnTravelRoute"
                          ToolTip="Hop-by-hop directions from where you are to any zone"/>
                <MenuItem Header="Spawn timers…" Click="OnSpawnsWindow"/>
                <MenuItem Header="Inventory…" Click="OnInventoryWindow"
                          ToolTip="Your worn gear by slot and what's in each bag — from the game's /outputfile inventory dump (type it in game, the file appears, EQBuddy reads it)"/>
                <MenuItem Header="Gear Locker…" Click="OnGearLocker"
                          ToolTip="Everything wearable you own, grouped by slot and compared — items outclassed by something else in your bags get flagged as dump candidates. Your bags, not 'BiS'."/>
                <MenuItem Header="Session history…" Click="OnHistory"/>
                <MenuItem Header="Drops by creature…" Click="OnDropsWindow"/>
                <Separator/>
                <MenuItem Header="Drop camp marker" Click="OnCampMarker"/>
                <MenuItem x:Name="ClickThroughItem" Header="Click-through (game clicks pass through)"
                          IsCheckable="True" Click="OnClickThrough"/>
                <Separator/>
                <MenuItem Header="Data &amp; imports">
                    <MenuItem Header="Wiki contribution pack…" Click="OnWikiPackWindow"
                              ToolTip="Paste-ready eqlwiki edits built from your own loot log — creatures with no page, pages that list no loot, and drops missing from a page. Nothing publishes automatically; you open each edit link, review and save."/>
                    <MenuItem Header="Import achievements…" Click="OnImportAchievements"
                              ToolTip="Read the game's /outputfile achievements dump and pre-mark Sky quest rewards (and raid clears) you completed before EQBuddy — preview first, adds only, never unticks"/>
                    <MenuItem Header="Copy /outputfile achievements" Click="OnCopyAchievementsCommand"
                              ToolTip="Puts the command on your clipboard — paste it into the game's chat, the game writes its achievements dump, then Import achievements… reads it"/>
                    <MenuItem x:Name="ReviewLogItem" Header="Review an archived log…" Click="OnReviewLog"
                              ToolTip="Replay a saved log read-only — Drops by Creature and the wiki contribution pack work against that session"/>
                    <MenuItem x:Name="ChooseLogFolderItem" Header="Choose log folder…" Click="OnChooseLogFolder"/>
                    <MenuItem Header="Auto-detect log folder" Click="OnAutoDetectLogFolder"/>
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem x:Name="VersionMenuItem" Header="EQBuddy" Click="OnOpenWebsite"
                              ToolTip="Open the EQBuddy page — downloads, guides, and a link to share"/>
                    <MenuItem Header="Quick tutorial…" Click="OnTutorial"/>
                    <MenuItem Header="Check for updates" Click="OnCheckUpdates"/>
                    <MenuItem Header="Send feedback…" Click="OnFeedback"/>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Margin="{DynamicResource PadWidget}">

            <!-- ============ MINI DASHBOARD MODE ============ -->
            <Grid x:Name="MiniRoot" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="MiniDot" Width="9" Height="9" Fill="{DynamicResource BadBrush}"
                         VerticalAlignment="Center" Margin="{DynamicResource TitleGap}"
                         ToolTip="Log status"/>
                <StackPanel x:Name="MiniChips" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#x2922;"
                        ToolTip="Expand (or double-click)" Click="OnRestore" Margin="{DynamicResource IndentM}"/>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#x2715;"
                        ToolTip="Close" Click="OnClose"/>
            </Grid>

            <!-- ============ FULL MODE ============ -->
            <StackPanel x:Name="NormalRoot" Width="320">

            <!-- Title bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource BadBrush}"
                             VerticalAlignment="Center" Margin="{DynamicResource TitleGap}"/>
                    <TextBlock Text="EQBuddy" FontWeight="Bold" FontSize="{DynamicResource FontTitleWindow}"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock x:Name="CharLabel" Grid.Column="1" Margin="{DynamicResource CharGap}" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontBody}" Foreground="{DynamicResource DimBrush}"
                           TextTrimming="CharacterEllipsis" Text="looking for a character…"
                           ToolTip="Follows whoever is actively playing (log file growth)"
                           MouseLeftButtonDown="OnCharLabelClick"/>
                <!-- #112 (Frankthetankk): EQBuddy's own footprint, on the record — off
                     by default, refreshed every few seconds when on. Its own column,
                     so a long character name ellipsizes instead of colliding. -->
                <!-- Fixed width, matching UI.Shared/PerfReadout.ReservedWidth: the widget
                     sizes itself to its contents, so a readout that grows a character at
                     9→10% used to resize the window every three seconds (#173). -->
                <TextBlock x:Name="PerfLabel" Grid.Column="2" Width="100"
                           TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           Margin="{DynamicResource GapS}" VerticalAlignment="Center" FontSize="{DynamicResource FontMetadata}"
                           Foreground="{DynamicResource DimBrush}" Visibility="Collapsed"
                           ToolTip="EQBuddy's own CPU (all cores) and memory — enable/disable under Options → Behavior"/>
                <!-- Feedback sits IN the title bar, not buried in the menu, and wears the
                     one green pill on the bar so the eye lands on it (David: the betas
                     live on reports, so the door should draw people). Text-glyph envelope,
                     not the emoji — color emoji ignore Foreground, the glyph tints. -->
                <Button Grid.Column="3" Style="{StaticResource IconButton}"
                        ToolTip="Send feedback — feature ideas and bug reports shape the beta features"
                        Click="OnFeedback">
                    <Border Background="{DynamicResource GoodWashBrush}" CornerRadius="{DynamicResource CornerCard}"
                            Padding="{DynamicResource BadgePad}">
                        <TextBlock Text="&#x2709;&#xFE0E;" FontSize="{DynamicResource FontTitleSection}"
                                   Foreground="{DynamicResource GoodBrush}"/>
                    </Border>
                </Button>
                <!-- EQBuddy Mobile lives IN the title bar (David: "should probably be its
                     own button on the dashboard, not buried in the options") — it is a
                     thing you open at the start of a session, not a setting. Preview-gated,
                     so it appears only on opted-in machines. Text-glyph phone, not the
                     emoji: color emoji ignore Foreground, the glyph tints with the theme. -->
                <Button x:Name="MobileBtn" Grid.Column="4" Style="{StaticResource IconButton}"
                        Content="&#x1F4F1;&#xFE0E;" Visibility="Collapsed"
                        ToolTip="EQBuddy Mobile (Beta) — show EQBuddy on a phone or tablet on your Wi-Fi"
                        Click="OnCompanion"/>
                <Button x:Name="GearBtn" Grid.Column="5" Style="{StaticResource IconButton}"
                        Content="&#x2699;&#xFE0F;" ToolTip="Settings" Click="OnGear"/>
                <!-- Tooltip is set in code (ResetPrompt): what this button does to your
                     log depends on whether archiving is on, and "Reset session stats"
                     hid that it touches a file at all (#159). -->
                <Button x:Name="ResetButton" Grid.Column="6" Style="{StaticResource IconButton}"
                        Content="&#x21BB;" ToolTipOpening="OnResetToolTipOpening"
                        ToolTip="Start a new session" Click="OnReset"/>
                <Button Grid.Column="7" Style="{StaticResource IconButton}" Content="&#x2013;"
                        ToolTip="Minimize to dashboard (starred stats only)" Click="OnMinimize"/>
                <Button Grid.Column="8" Style="{StaticResource IconButton}" Content="&#x2715;"
                        ToolTip="Close" Click="OnClose"/>
            </Grid>

            <!-- Logging-off reminder -->
            <Border x:Name="LogBanner" Background="{DynamicResource WarnWashBrush}" CornerRadius="{DynamicResource CornerCard}" Padding="{DynamicResource PadRow}"
                    Margin="{DynamicResource LeadM}" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontBody}">
                    <Run Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" Text="Logging looks off."/>
                    <Run Text=" Type "/><Run FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" Text="/log"/>
                    <Run Text=" in the game's chat window. (EQBuddy enables it automatically for future game launches.)"/>
                </TextBlock>
            </Border>

            <!-- Update available -->
            <Border x:Name="UpdateBanner" Background="{DynamicResource GoodWashBrush}" CornerRadius="{DynamicResource CornerCard}" Padding="{DynamicResource PadRow}"
                    Margin="{DynamicResource LeadM}" Visibility="Collapsed" Cursor="Hand"
                    MouseLeftButtonDown="OnUpdateBannerClick">
                <TextBlock x:Name="UpdateText" TextWrapping="Wrap" FontSize="{DynamicResource FontBody}"
                           Foreground="{DynamicResource GoodBrush}" FontWeight="SemiBold"/>
            </Border>

            <!-- Session line -->
            <Grid Margin="{DynamicResource KpiRow}">
                <TextBlock x:Name="ZoneText" Style="{StaticResource Dim}" Text="—"/>
                <TextBlock x:Name="SessionText" Style="{StaticResource Dim}" HorizontalAlignment="Right" Text="session 0:00"/>
            </Grid>

            <!-- KPI strip (2026-08-11 modernization): the headline numbers before any
                 card — always visible, one glance. Values are tabular semibold; DPS
                 wears the accent. Hairline separators, not boxes. -->
            <Border Margin="{DynamicResource StackS}" CornerRadius="{DynamicResource CornerPanel}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    Background="{DynamicResource PanelBrush}">
                <UniformGrid Columns="4">
                    <StackPanel Margin="{DynamicResource PadKpi}">
                        <TextBlock Text="dps" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock x:Name="KpiDps" Text="0" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="{DynamicResource PadKpi}">
                            <TextBlock Text="kills" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock x:Name="KpiKills" Text="0" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="{DynamicResource PadKpi}">
                            <TextBlock Text="loot" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock x:Name="KpiLoot" Text="0" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="{DynamicResource PadKpi}">
                            <TextBlock Text="xp/hr" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock x:Name="KpiXp" Text="0" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Border>

            <!-- Sections -->
            <ScrollViewer x:Name="SectionScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SectionsPanel">
            <Expander x:Name="CombatSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Swords" Text="Combat"/>
                        <TextBlock x:Name="CombatHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0 dps"/>
                        <ToggleButton x:Name="StarDps" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="dps" Click="OnStarChanged" ToolTip="Show DPS in mini dashboard"/>
                        <!-- Pet damage has no card of its own (it's the fold-out below), but its
                             watch-toggle lives up here with the other stars per David: one place
                             to say what you watch when minimized. The 🐾 tells the two stars apart. -->
                        <!-- The glyphs toggle their star too (David's live catch, 1.59.0:
                             clicking ⚡ fell through to the expander and collapsed the
                             section — a label beside a toggle reads as part of it). -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <local:EqIcon Glyph="Paw" Size="9" VerticalAlignment="Center"
                                       Margin="{DynamicResource GapXs}" Opacity="0.75" Cursor="Hand" Tag="pet"
                                       MouseLeftButtonDown="OnStarGlyphClick"
                                       ToolTip="Show pet damage in mini dashboard"/>
                            <ToggleButton x:Name="StarPet" Style="{StaticResource StarToggle}"
                                          Tag="pet" Click="OnStarChanged"
                                          ToolTip="Show pet damage in mini dashboard"/>
                        </StackPanel>
                        <!-- Proc rate rides the same one-place rule (David, 2026-08-11):
                             optional ⚡ chip for the minimized view, toggled where the
                             other combat watches live. -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <local:EqIcon Glyph="Bolt" Size="9" VerticalAlignment="Center"
                                       Margin="{DynamicResource GapXs}" Opacity="0.75" Cursor="Hand" Tag="procs"
                                       MouseLeftButtonDown="OnStarGlyphClick"
                                       ToolTip="Show proc rate (procs per combat-minute) in mini dashboard"/>
                            <ToggleButton x:Name="StarProcs" Style="{StaticResource StarToggle}"
                                          Tag="procs" Click="OnStarChanged"
                                          ToolTip="Show proc rate (procs per combat-minute) in mini dashboard"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <!-- Session-pace sparkline (2026-08-11): damage per minute over the
                         last half hour, area-filled, hottest minute marked. The data
                         always existed (_damageTimeline feeds History) — now it's drawn. -->
                    <Grid x:Name="CombatSparkHost" Height="34" Margin="{DynamicResource ListBlock}" Visibility="Collapsed"
                          ToolTip="Damage per minute, last 30 minutes — the dot marks your hottest minute">
                        <Polygon x:Name="CombatSparkFill"/>
                        <Polyline x:Name="CombatSpark" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource ChartYouBrush}"/>
                        <Ellipse x:Name="CombatSparkPeak" Width="6" Height="6" Visibility="Collapsed"
                                 Fill="{DynamicResource ChartYouBrush}"
                                 Stroke="{DynamicResource BgBrush}" StrokeThickness="1.5"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                    <!-- The fight in front of you, before the session aggregate: mid-fight
                         that's the number you're reacting to, and a session average tells you
                         nothing about whether this pull is going badly. -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CombatFightLabel" Style="{StaticResource IconButton}" FontSize="{DynamicResource FontCaption}"
                                HorizontalAlignment="Left" Visibility="Collapsed"
                                Foreground="{DynamicResource AccentBrush}" Click="OnToggleCombatFight">
                            <local:EqFoldLabel Text="Last fight" Ink="AccentBrush"/>
                        </Button>
                        <Button x:Name="CombatFightCopy" Style="{StaticResource IconButton}"
                                Margin="{DynamicResource GapS}" Visibility="Collapsed"
                                Click="OnCopyFight"
                                ToolTip="Copy this fight as Discord-ready text (a monospace block — the official Discord blocks images, so the parse travels as text). Your numbers only, from your log.">
                            <local:EqIcon Glyph="Copy"/>
                        </Button>
                        <Button x:Name="CombatFightTimeline" Style="{StaticResource IconButton}"
                                Margin="{DynamicResource GapXs}" Visibility="Collapsed"
                                Click="OnOpenTimeline"
                                ToolTip="Fight timeline: the whole pull on one canvas — a lane per skill, every hit, miss and resist, with a DPS-over-time graph. Scroll to zoom, drag to pan.">
                            <local:EqIcon Glyph="Timeline"/>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="CombatFightBody" Visibility="Collapsed">
                        <TextBlock x:Name="CombatFightText" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Margin="{DynamicResource RowTight}"/>
                        <TextBlock x:Name="CombatFightSplit" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Margin="{DynamicResource StackXxs}" Visibility="Collapsed"/>
                        <TextBlock x:Name="CombatFightOutLabel" Text="Your damage"
                                   Style="{StaticResource SectionLabel}" Visibility="Collapsed"/>
                        <ItemsControl x:Name="CombatFightList" Margin="{DynamicResource StackXs}"/>
                        <TextBlock x:Name="CombatFightInLabel" Text="Damage you took"
                                   Style="{StaticResource SectionLabel}" Visibility="Collapsed"/>
                        <ItemsControl x:Name="CombatFightInList" Margin="{DynamicResource ListBlock}"/>
                    </StackPanel>
                    <Button x:Name="CombatSessionLabel" Style="{StaticResource IconButton}" FontSize="{DynamicResource FontCaption}"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource AccentBrush}" Click="OnToggleCombatSession">
                        <local:EqFoldLabel Text="Session so far" Ink="AccentBrush"/>
                    </Button>
                    <StackPanel x:Name="CombatSessionBody">
                    <TextBlock x:Name="CombatSummary" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="{DynamicResource ListBlock}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Damage by attack" Style="{StaticResource SectionLabel}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="Damage by attack"/>
                        <StackPanel Grid.Column="1" x:Name="DmgOutSortBar" Orientation="Horizontal"/>
                    </Grid>
                    <ItemsControl x:Name="DamageSourceList" Margin="{DynamicResource ListBlock}"/>
                    <local:EqFoldLabel x:Name="PetAbilityLabel" Text="Pet abilities" Open="False"
                               Section="True" Margin="{DynamicResource SectionLead}" Visibility="Collapsed"
                               Cursor="Hand" MouseLeftButtonDown="OnPetAbilitiesToggled"
                               ToolTip="What your pet is using, split out of its Pet row above — click to expand"/>
                    <ItemsControl x:Name="PetAbilityList" Margin="{DynamicResource ListBlock}" Visibility="Collapsed"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Damage taken from" Style="{StaticResource SectionLabel}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="Damage taken from"/>
                        <StackPanel Grid.Column="1" x:Name="DmgInSortBar" Orientation="Horizontal"/>
                    </Grid>
                    <ItemsControl x:Name="DamageTakenList" Margin="{DynamicResource ListBlock}"/>
                    <TextBlock x:Name="RecentFightsLabel" Text="Recent fights" Style="{StaticResource SectionLabel}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="RecentFightsList" Margin="{DynamicResource ListBlock}"/>
                    <TextBlock x:Name="AreaSpellLabel" Text="Area spells (per cast)" Style="{StaticResource SectionLabel}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="AreaSpellList" Margin="{DynamicResource ListBlock}"/>
                    <local:EqCardTitle x:Name="ProcLabel" Icon="Bolt" Text="Procs" Visibility="Collapsed"
                               ToolTip="Spell damage that fired without a cast — weapon procs, poisons, item effects. Rate is per minute of combat, the same denominator as DPS."/>
                    <ItemsControl x:Name="ProcList" Margin="{DynamicResource ListBlock}"/>
                    <TextBlock x:Name="StanceLabel" Text="By stance" Style="{StaticResource SectionLabel}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="StanceList" Margin="{DynamicResource LeadXxs}"/>
                    <TextBlock x:Name="InvocationLabel" Text="By invocation" Style="{StaticResource SectionLabel}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="InvocationList" Margin="{DynamicResource LeadXxs}"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="HealingSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Heal" Text="Healing"/>
                        <TextBlock x:Name="HealingHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0 hps"/>
                        <ToggleButton x:Name="StarHps" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="hps" Click="OnStarChanged" ToolTip="Show HPS in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <Button x:Name="HealFightLabel" Style="{StaticResource IconButton}" FontSize="{DynamicResource FontCaption}"
                            HorizontalAlignment="Left" Visibility="Collapsed"
                            Foreground="{DynamicResource AccentBrush}" Click="OnToggleHealFight">
                        <local:EqFoldLabel Text="Last fight" Ink="AccentBrush"/>
                    </Button>
                    <StackPanel x:Name="HealFightBody" Visibility="Collapsed">
                        <TextBlock x:Name="HealFightText" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Margin="{DynamicResource RowTight}"/>
                        <ItemsControl x:Name="HealFightList" Margin="{DynamicResource StackXs}"/>
                    </StackPanel>
                    <Button x:Name="HealSessionLabel" Style="{StaticResource IconButton}" FontSize="{DynamicResource FontCaption}"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource AccentBrush}" Click="OnToggleHealSession">
                        <local:EqFoldLabel Text="Session so far" Ink="AccentBrush"/>
                    </Button>
                    <StackPanel x:Name="HealSessionBody">
                    <TextBlock x:Name="HealingSummary" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="{DynamicResource ListBlock}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HealSpellsLabel" Text="Heals cast" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource GoodBrush}" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="1" x:Name="HealSortBar" Orientation="Horizontal" Visibility="Collapsed"/>
                    </Grid>
                    <ItemsControl x:Name="HealSpellList" Margin="{DynamicResource ListBlock}"/>
                    <TextBlock x:Name="HealersLabel" Text="Healed by" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold"
                               Foreground="{DynamicResource GoodBrush}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="HealerList" Margin="{DynamicResource LeadXxs}"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="KillsSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Skull" Text="Kills"/>
                        <TextBlock x:Name="KillsHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0"/>
                        <ToggleButton x:Name="StarKills" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="kills" Click="OnStarChanged" ToolTip="Show kills in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <!-- Built in code by KillsCardView (Gate 5b) — the first card written as
                     an IWidgetCard against ICardContext rather than against MainWindow.
                     What it SHOWS is UI.Shared/KillsPresentation, tested without a window. -->
                <ContentControl x:Name="KillsBody"/>
            </Expander>

            <Expander x:Name="LootSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Bag" Text="Loot"/>
                        <TextBlock x:Name="LootHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0 items"/>
                        <TextBlock Grid.Column="2" Text="&#x1F5FA;" FontSize="{DynamicResource FontBody}" Cursor="Hand"
                                   Margin="{DynamicResource IndentM}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DimBrush}"
                                   ToolTip="Open the Quest Tracker"
                                   MouseLeftButtonUp="OnLootQuestMap"/>
                        <ToggleButton x:Name="StarLoot" Grid.Column="3" Style="{StaticResource StarToggle}"
                                      Tag="loot" Click="OnStarChanged" ToolTip="Show loot count in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <!-- The card BODY is built in code by LootCardView (Gate 4,
                     docs/DesignSystem.md §11.5): the show/sort filters are the app's
                     EqSegmentedStrip rather than the sixteenth hand-built copy, and the
                     ratchet holds the file to the scale — which it cannot do here, because
                     MainWindow.xaml does not join DesignRatchetTests until Gate 5. -->
                <ContentControl x:Name="LootBody"/>
            </Expander>

            <!-- Motes (discussion #49, flipwon): the Potential upgrade-currency ladder as a
                 first-class card — the Loot list keeps showing them too; this is the
                 at-a-glance view with the per-hour rate farmers actually watch. -->
            <Expander x:Name="MotesSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Sparkle" Text="Motes"/>
                        <TextBlock x:Name="MotesHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0"/>
                        <ToggleButton x:Name="StarMotes" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="motes" Click="OnStarChanged" ToolTip="Show motes in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <ContentControl x:Name="MotesBody"/>
            </Expander>

            <!-- ONE card for every quest surface (David, 2026-08-16). It replaced the
                 "Sky Quest" and "Epics" cards, each of which carried a full tabbed
                 checklist on the widget — a review surface by the rule in CLAUDE.md, not
                 a glance one. The Quest Tracker window owns that job on its own three
                 tabs (General · Epic 1.0 · Plane of Sky), and this card is the way in,
                 which is also why the ⚙ menu no longer carries a Quest tracker line.
                 The header still reports both checklists, so the glance survives. -->
            <Button x:Name="QuestsSection" Style="{StaticResource SectionLink}" Click="OnQuestsWindow"
                    ToolTip="Open the Quest Tracker — search every quest by reward, item, quest giver or zone, and work your Epic 1.0 and Plane of Sky checklists">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <local:EqCardTitle Icon="Map" Text="Quests"/>
                    <TextBlock x:Name="QuestsHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text=""/>
                </Grid>
            </Button>

            <Expander x:Name="GearSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Gear" Text="Gear"/>
                        <TextBlock x:Name="GearHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0/0"/>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <CheckBox x:Name="GearByZoneCheck"
                              Margin="{DynamicResource ListBlock}"
                              Checked="OnGearByZoneToggled"
                              Unchecked="OnGearByZoneToggled"
                              Content="Group by farm zone"
                              FontSize="{DynamicResource FontMetadata}"
                              Foreground="{DynamicResource DimBrush}"/>
                    <TextBlock x:Name="GearListName" Style="{StaticResource Dim}"
                               TextWrapping="Wrap" Margin="{DynamicResource ListBlock}"/>
                    <ScrollViewer MaxHeight="320"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Padding="{DynamicResource GapXs}">
                        <ItemsControl x:Name="GearChecklistList"/>
                    </ScrollViewer>
                </StackPanel>
            </Expander>

            <Expander x:Name="TrackedSection" Style="{StaticResource Section}" Visibility="Collapsed">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Target" Text="Watch"/>
                        <TextBlock x:Name="TrackedHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0"/>
                    </Grid>
                </Expander.Header>
                <ContentControl x:Name="TrackedBody"/>
            </Expander>

            <Expander x:Name="RaidsSection" Style="{StaticResource Section}" Visibility="Collapsed">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Group" Text="Raids"/>
                        <TextBlock x:Name="RaidsHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0"/>
                    </Grid>
                </Expander.Header>
                <StackPanel x:Name="RaidsPanel"/>
            </Expander>

            <Expander x:Name="BuffsSection" Style="{StaticResource Section}" Visibility="Collapsed">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Timer" Text="Buffs"/>
                        <TextBlock x:Name="BuffsHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0"/>
                        <!-- No mini chip behind this star — it opens the Buff Set breakout
                             while minimized (#120 stage 2, Frankthetankk). -->
                        <ToggleButton x:Name="StarBuffs" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="buffs" Click="OnStarChanged"
                                      ToolTip="Show the Buff Set breakout while minimized — your per-class set with live states, editable in place"/>
                    </Grid>
                </Expander.Header>
                <StackPanel x:Name="BuffsPanel"/>
            </Expander>

            <Expander x:Name="MoneySection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Coin" Text="Money"/>
                        <TextBlock x:Name="MoneyHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0c"/>
                        <ToggleButton x:Name="StarMoney" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="money" Click="OnStarChanged" ToolTip="Show money in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <ContentControl x:Name="MoneyBody"/>
            </Expander>

            <Expander x:Name="ProgressSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Chart" Text="Progress"/>
                        <TextBlock x:Name="ProgressHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0% xp"/>
                        <ToggleButton x:Name="StarXp" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="xp" Click="OnStarChanged" ToolTip="Show XP in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <!-- Lifted to ProgressCardView.cs (Gate 5b) — the host carries no
                     Visibility and no Margin of its own; the lifted control owns both
                     (trap 15: a control that hides itself inside a host that also
                     hides itself has two switches for one state). -->
                <ContentControl x:Name="ProgressBody"/>
            </Expander>

            <Expander x:Name="FactionSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Scales" Text="Faction"/>
                        <TextBlock x:Name="FactionHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="—"/>
                    </Grid>
                </Expander.Header>
                <ContentControl x:Name="FactionBody"/>
            </Expander>

            <Expander x:Name="MiscSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:EqCardTitle Icon="Location" Text="Travels &amp; Deaths"/>
                        <TextBlock x:Name="MiscHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0 deaths"/>
                        <ToggleButton x:Name="StarDeaths" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="deaths" Click="OnStarChanged" ToolTip="Show deaths in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <TextBlock Text="Deaths" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BadBrush}"/>
                    <ItemsControl x:Name="DeathList" Margin="{DynamicResource ListBlock}"/>
                    <TextBlock Text="Zones visited" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl x:Name="ZoneList" Margin="{DynamicResource ListBlock}"/>
                    <TextBlock x:Name="MarkersLabel" Text="Camp markers" Style="{StaticResource SectionLabel}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="MarkerList" Margin="{DynamicResource LeadXxs}"/>
                </StackPanel>
            </Expander>
            </StackPanel>
            </ScrollViewer>

            </StackPanel>
        </StackPanel>
    </Border>

    <!-- Bottom-right resize grip. Only visible in full mode — the mini dashboard has its
         own compact width and isn't meant to be stretched. -->
    <Thumb x:Name="ResizeGrip" Width="14" Height="14" Margin="{DynamicResource GripInset}"
           HorizontalAlignment="Right" VerticalAlignment="Bottom"
           Cursor="SizeNWSE" ToolTip="Drag to resize (scales text and everything else with it)"
           DragStarted="OnResizeGripStarted" DragDelta="OnResizeGripDelta">
        <Thumb.Template>
            <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
        </Thumb.Template>
    </Thumb>

    <!-- Bottom-edge height grip (Reddit ask, 2026-08-09): drag to show more or fewer
         cards before the list scrolls — TEXT size stays put, that's the corner grip's
         job. The corner keeps its own 20px so the two grips never fight. -->
    <Thumb x:Name="HeightGrip" Height="12" Margin="{DynamicResource GripBar}"
           HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
           Cursor="SizeNS" MouseEnter="OnHeightGripEnter"
           DragStarted="OnHeightGripStarted" DragDelta="OnHeightGripDelta"
           DragCompleted="OnHeightGripCompleted" MouseDoubleClick="OnHeightGripReset">
        <Thumb.Template>
            <!-- Invisible until hovered: 6px was an unfindable target (1.66 field test —
                 "dragging the bottom doesn't work" meant "I never hit it"). Twice the
                 hit area, and a hint line under the cursor so grabbing it feels real. -->
            <ControlTemplate TargetType="Thumb">
                <Grid Background="Transparent">
                    <Rectangle x:Name="HintLine" Height="2.5" VerticalAlignment="Bottom"
                               Margin="{DynamicResource GripLine}" RadiusX="1.25" RadiusY="1.25"
                               Fill="{DynamicResource AccentBrush}" Opacity="0"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="HintLine" Property="Opacity" Value="0.7"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Thumb.Template>
    </Thumb>
    </Grid>
</Window>
