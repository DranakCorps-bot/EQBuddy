<Window x:Class="EQBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQBuddy" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize">

    <!-- WindowStyle=None + AllowsTransparency means there's no native resize border, so
         ResizeGrip below drives UiScale (not Width/Height directly) from drag distance —
         SizeToContent="WidthAndHeight" then grows or shrinks the window to fit the
         rescaled content, the same way the Options "Widget size" slider already does. -->
    <Grid>
    <Border x:Name="RootBorderElement" Background="{DynamicResource BgBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="VersionMenuItem" Header="EQBuddy" IsEnabled="False"/>
                <MenuItem Header="Check for updates" Click="OnCheckUpdates"/>
                <MenuItem Header="Options… (size, opacity, watch rules)" Click="OnOptions"/>
                <MenuItem Header="Quick tutorial…" Click="OnTutorial"/>
                <MenuItem Header="Drop camp marker" Click="OnCampMarker"/>
                <MenuItem Header="Session history…" Click="OnHistory"/>
                <MenuItem Header="Spawn timers…" Click="OnSpawnsWindow"/>
                <MenuItem Header="Quest tracker…" Click="OnQuestsWindow"/>
                <MenuItem Header="Drops by creature…" Click="OnDropsWindow"/>
                <MenuItem x:Name="TrackSpawnsItem" Header="Track spawns (named respawn timers)"
                          IsCheckable="True" Click="OnTrackSpawns"/>
                <MenuItem x:Name="ClickThroughItem" Header="Click-through (game clicks pass through)"
                          IsCheckable="True" Click="OnClickThrough"/>
                <MenuItem Header="Send feedback…" Click="OnFeedback"/>
                <Separator/>
                <MenuItem x:Name="ChooseLogFolderItem" Header="Choose log folder…" Click="OnChooseLogFolder"/>
                <MenuItem Header="Auto-detect log folder" Click="OnAutoDetectLogFolder"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Margin="10">

            <!-- ============ MINI DASHBOARD MODE ============ -->
            <Grid x:Name="MiniRoot" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="MiniDot" Width="9" Height="9" Fill="{DynamicResource BadBrush}"
                         VerticalAlignment="Center" Margin="2,0,8,0"
                         ToolTip="Log status"/>
                <StackPanel x:Name="MiniChips" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#x2922;"
                        ToolTip="Expand (or double-click)" Click="OnRestore" Margin="8,0,0,0"/>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#x2715;"
                        ToolTip="Close" Click="OnClose"/>
            </Grid>

            <!-- ============ FULL MODE ============ -->
            <StackPanel x:Name="NormalRoot" Width="320">

            <!-- Title bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource BadBrush}"
                             VerticalAlignment="Center" Margin="2,0,7,0"/>
                    <TextBlock Text="EQBuddy" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock x:Name="CharLabel" Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource DimBrush}"
                           TextTrimming="CharacterEllipsis" Text="looking for a character…"
                           ToolTip="Follows whoever is actively playing (log file growth)"/>
                <!-- Feedback sits IN the title bar, not buried in the menu, and wears the
                     one green pill on the bar so the eye lands on it (David: the betas
                     live on reports, so the door should draw people). Text-glyph envelope,
                     not the emoji — color emoji ignore Foreground, the glyph tints. -->
                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                        ToolTip="Send feedback — feature ideas and bug reports shape the beta features"
                        Click="OnFeedback">
                    <Border Background="{DynamicResource GoodWashBrush}" CornerRadius="6"
                            Padding="4,0,4,1">
                        <TextBlock Text="&#x2709;&#xFE0E;" FontSize="13"
                                   Foreground="{DynamicResource GoodBrush}"/>
                    </Border>
                </Button>
                <Button x:Name="GearBtn" Grid.Column="3" Style="{StaticResource IconButton}"
                        Content="&#x2699;&#xFE0F;" ToolTip="Settings" Click="OnGear"/>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#x21BB;"
                        ToolTip="Reset session stats" Click="OnReset"/>
                <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#x2013;"
                        ToolTip="Minimize to dashboard (starred stats only)" Click="OnMinimize"/>
                <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#x2715;"
                        ToolTip="Close" Click="OnClose"/>
            </Grid>

            <!-- Logging-off reminder -->
            <Border x:Name="LogBanner" Background="{DynamicResource WarnWashBrush}" CornerRadius="6" Padding="8,6"
                    Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" FontSize="12">
                    <Run Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" Text="Logging looks off."/>
                    <Run Text=" Type "/><Run FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" Text="/log"/>
                    <Run Text=" in the game's chat window. (EQBuddy enables it automatically for future game launches.)"/>
                </TextBlock>
            </Border>

            <!-- Update available -->
            <Border x:Name="UpdateBanner" Background="{DynamicResource GoodWashBrush}" CornerRadius="6" Padding="8,6"
                    Margin="0,8,0,0" Visibility="Collapsed" Cursor="Hand"
                    MouseLeftButtonDown="OnUpdateBannerClick">
                <TextBlock x:Name="UpdateText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource GoodBrush}" FontWeight="SemiBold"/>
            </Border>

            <!-- Session line -->
            <Grid Margin="2,8,2,4">
                <TextBlock x:Name="ZoneText" Style="{StaticResource Dim}" Text="—"/>
                <TextBlock x:Name="SessionText" Style="{StaticResource Dim}" HorizontalAlignment="Right" Text="session 0:00"/>
            </Grid>

            <!-- Sections -->
            <ScrollViewer x:Name="SectionScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SectionsPanel">
            <Expander x:Name="CombatSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x2694;&#xFE0F; Combat" FontSize="13"/>
                        <TextBlock x:Name="CombatHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0 dps"/>
                        <ToggleButton x:Name="StarDps" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="dps" Click="OnStarChanged" ToolTip="Show DPS in mini dashboard"/>
                        <!-- Pet damage has no card of its own (it's the fold-out below), but its
                             watch-toggle lives up here with the other stars per David: one place
                             to say what you watch when minimized. The 🐾 tells the two stars apart. -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <TextBlock Text="🐾" FontSize="9" VerticalAlignment="Center"
                                       Margin="2,0,0,0" Opacity="0.75"/>
                            <ToggleButton x:Name="StarPet" Style="{StaticResource StarToggle}"
                                          Tag="pet" Click="OnStarChanged"
                                          ToolTip="Show pet damage in mini dashboard"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <!-- The fight in front of you, before the session aggregate: mid-fight
                         that's the number you're reacting to, and a session average tells you
                         nothing about whether this pull is going badly. -->
                    <Button x:Name="CombatFightLabel" Style="{StaticResource IconButton}" FontSize="11"
                            HorizontalAlignment="Left" Content="▾ Last fight" Visibility="Collapsed"
                            Foreground="{DynamicResource AccentBrush}" Click="OnToggleCombatFight"/>
                    <StackPanel x:Name="CombatFightBody" Visibility="Collapsed">
                        <TextBlock x:Name="CombatFightText" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Margin="0,1,0,2"/>
                        <TextBlock x:Name="CombatFightSplit" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Margin="0,0,0,2" Visibility="Collapsed"/>
                        <TextBlock x:Name="CombatFightOutLabel" Text="Your damage" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   Visibility="Collapsed"/>
                        <ItemsControl x:Name="CombatFightList" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CombatFightInLabel" Text="Damage you took" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   Visibility="Collapsed"/>
                        <ItemsControl x:Name="CombatFightInList" Margin="0,2,0,4"/>
                    </StackPanel>
                    <Button x:Name="CombatSessionLabel" Style="{StaticResource IconButton}" FontSize="11"
                            HorizontalAlignment="Left" Content="▾ Session so far"
                            Foreground="{DynamicResource AccentBrush}" Click="OnToggleCombatSession"/>
                    <StackPanel x:Name="CombatSessionBody">
                    <TextBlock x:Name="CombatSummary" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <Grid>
                        <TextBlock Text="Damage by attack" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="sort:" FontSize="10" Foreground="{DynamicResource DimBrush}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="DmgOutSortTotal" Text="total" FontSize="10" Cursor="Hand" Tag="total"
                                       Foreground="{DynamicResource AccentBrush}" MouseLeftButtonDown="OnSortDmgOut"/>
                            <TextBlock x:Name="DmgOutSortDps" Text="dps" FontSize="10" Cursor="Hand" Tag="rate" Margin="6,0,0,0"
                                       ToolTip="Per-ability DPS: that ability's damage ÷ total time in combat"
                                       Foreground="{DynamicResource DimBrush}" MouseLeftButtonDown="OnSortDmgOut"/>
                            <TextBlock x:Name="DmgOutSortHits" Text="hits" FontSize="10" Cursor="Hand" Tag="hits" Margin="6,0,0,0"
                                       Foreground="{DynamicResource DimBrush}" MouseLeftButtonDown="OnSortDmgOut"/>
                            <TextBlock x:Name="DmgOutSortAvg" Text="avg" FontSize="10" Cursor="Hand" Tag="avg" Margin="6,0,0,0"
                                       Foreground="{DynamicResource DimBrush}" MouseLeftButtonDown="OnSortDmgOut"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="DamageSourceList" Margin="0,2,0,4"/>
                    <TextBlock x:Name="PetAbilityLabel" Text="▸ Pet abilities" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"
                               Cursor="Hand" MouseLeftButtonDown="OnPetAbilitiesToggled"
                               ToolTip="What your pet is using, split out of its Pet row above — click to expand"/>
                    <ItemsControl x:Name="PetAbilityList" Margin="0,2,0,4" Visibility="Collapsed"/>
                    <Grid>
                        <TextBlock Text="Damage taken from" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="sort:" FontSize="10" Foreground="{DynamicResource DimBrush}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="DmgInSortTotal" Text="total" FontSize="10" Cursor="Hand" Tag="total"
                                       Foreground="{DynamicResource AccentBrush}" MouseLeftButtonDown="OnSortDmgIn"/>
                            <TextBlock x:Name="DmgInSortHits" Text="hits" FontSize="10" Cursor="Hand" Tag="hits" Margin="6,0,0,0"
                                       Foreground="{DynamicResource DimBrush}" MouseLeftButtonDown="OnSortDmgIn"/>
                            <TextBlock x:Name="DmgInSortAvg" Text="avg" FontSize="10" Cursor="Hand" Tag="avg" Margin="6,0,0,0"
                                       Foreground="{DynamicResource DimBrush}" MouseLeftButtonDown="OnSortDmgIn"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="DamageTakenList" Margin="0,2,0,4"/>
                    <TextBlock x:Name="RecentFightsLabel" Text="Recent fights" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="RecentFightsList" Margin="0,2,0,4"/>
                    <TextBlock x:Name="AreaSpellLabel" Text="Area spells (per cast)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="AreaSpellList" Margin="0,2,0,4"/>
                    <TextBlock x:Name="StanceLabel" Text="By stance" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="StanceList" Margin="0,2,0,0"/>
                    <TextBlock x:Name="InvocationLabel" Text="By invocation" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="InvocationList" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="HealingSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x2695;&#xFE0F; Healing" FontSize="13"/>
                        <TextBlock x:Name="HealingHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0 hps"/>
                        <ToggleButton x:Name="StarHps" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="hps" Click="OnStarChanged" ToolTip="Show HPS in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <Button x:Name="HealFightLabel" Style="{StaticResource IconButton}" FontSize="11"
                            HorizontalAlignment="Left" Content="▾ Last fight" Visibility="Collapsed"
                            Foreground="{DynamicResource AccentBrush}" Click="OnToggleHealFight"/>
                    <StackPanel x:Name="HealFightBody" Visibility="Collapsed">
                        <TextBlock x:Name="HealFightText" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                   Margin="0,1,0,2"/>
                        <ItemsControl x:Name="HealFightList" Margin="0,0,0,4"/>
                    </StackPanel>
                    <Button x:Name="HealSessionLabel" Style="{StaticResource IconButton}" FontSize="11"
                            HorizontalAlignment="Left" Content="▾ Session so far"
                            Foreground="{DynamicResource AccentBrush}" Click="OnToggleHealSession"/>
                    <StackPanel x:Name="HealSessionBody">
                    <TextBlock x:Name="HealingSummary" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <Grid>
                        <TextBlock x:Name="HealSpellsLabel" Text="Heals cast" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GoodBrush}" Visibility="Collapsed"/>
                        <StackPanel x:Name="HealSortBar" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                            <TextBlock Text="sort:" FontSize="10" Foreground="{DynamicResource DimBrush}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HealSortTotal" Text="total" FontSize="10" Cursor="Hand" Tag="total"
                                       Foreground="{DynamicResource AccentBrush}" MouseLeftButtonDown="OnSortHeal"/>
                            <TextBlock x:Name="HealSortHps" Text="hps" FontSize="10" Cursor="Hand" Tag="rate" Margin="6,0,0,0"
                                       ToolTip="Per-spell HPS: that spell's healing ÷ total time in combat"
                                       Foreground="{DynamicResource DimBrush}" MouseLeftButtonDown="OnSortHeal"/>
                            <TextBlock x:Name="HealSortHits" Text="casts" FontSize="10" Cursor="Hand" Tag="hits" Margin="6,0,0,0"
                                       Foreground="{DynamicResource DimBrush}" MouseLeftButtonDown="OnSortHeal"/>
                            <TextBlock x:Name="HealSortAvg" Text="avg" FontSize="10" Cursor="Hand" Tag="avg" Margin="6,0,0,0"
                                       Foreground="{DynamicResource DimBrush}" MouseLeftButtonDown="OnSortHeal"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="HealSpellList" Margin="0,2,0,4"/>
                    <TextBlock x:Name="HealersLabel" Text="Healed by" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource GoodBrush}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="HealerList" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="KillsSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F480; Kills" FontSize="13"/>
                        <TextBlock x:Name="KillsHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0"/>
                        <ToggleButton x:Name="StarKills" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="kills" Click="OnStarChanged" ToolTip="Show kills in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <TextBlock x:Name="KillsSummary" Style="{StaticResource Dim}" Margin="0,2,0,4"/>
                    <ItemsControl x:Name="KillList"/>
                    <TextBlock x:Name="FarmingLabel" Text="Farming (per creature)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="FarmingList" Margin="0,2,0,0"/>
                    <TextBlock x:Name="PartyKillsLabel" Text="Group kills" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
                    <ItemsControl x:Name="PartyKillList" Margin="0,2,0,0"/>
                </StackPanel>
            </Expander>

            <Expander x:Name="LootSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F392; Loot" FontSize="13"/>
                        <TextBlock x:Name="LootHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0 items"/>
                        <TextBlock Grid.Column="2" Text="&#x1F5FA;" FontSize="12" Cursor="Hand"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DimBrush}"
                                   ToolTip="Open the Quest Tracker"
                                   MouseLeftButtonUp="OnLootQuestMap"/>
                        <ToggleButton x:Name="StarLoot" Grid.Column="3" Style="{StaticResource StarToggle}"
                                      Tag="loot" Click="OnStarChanged" ToolTip="Show loot count in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <!-- Sort toggle (Klona11, discussion #43): count keeps the original
                         biggest-stacks-first order; name is alphabetical. -->
                    <StackPanel x:Name="LootSortBar" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,0,2,1">
                        <TextBlock Text="sort:" FontSize="10" Foreground="{DynamicResource DimBrush}"
                                   Margin="0,0,4,0"/>
                        <TextBlock x:Name="LootSortCount" Text="count" FontSize="10" Cursor="Hand"
                                   Tag="count" MouseLeftButtonDown="OnLootSort" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LootSortName" Text="name" FontSize="10" Cursor="Hand"
                                   Tag="name" MouseLeftButtonDown="OnLootSort"/>
                    </StackPanel>
                    <ItemsControl x:Name="LootList"/>
                    <TextBlock x:Name="CraftedLabel" Text="Created by merging" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="CraftedList" Margin="0,2,0,0"/>
                    <!-- Target drops (TARGET-*): what the creature you're fighting can drop,
                         wiki knowledge merged with this session's observed counts. -->
                    <StackPanel x:Name="TargetBlock" Visibility="Collapsed"
                                Margin="0,6,0,0">
                        <TextBlock x:Name="TargetHeader" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="TargetDropsList" Margin="10,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Motes (discussion #49, flipwon): the Potential upgrade-currency ladder as a
                 first-class card — the Loot list keeps showing them too; this is the
                 at-a-glance view with the per-hour rate farmers actually watch. -->
            <Expander x:Name="MotesSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F52E; Motes" FontSize="13"/>
                        <TextBlock x:Name="MotesHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0"/>
                        <ToggleButton x:Name="StarMotes" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="motes" Click="OnStarChanged" ToolTip="Show motes in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <TextBlock x:Name="MotesSummaryText" Style="{StaticResource Dim}" Margin="0,2,0,4"/>
                    <ItemsControl x:Name="MotesList"/>
                </StackPanel>
            </Expander>

            <Expander x:Name="SkyQuestSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x2601; Sky Quest" FontSize="13"/>
                        <TextBlock x:Name="SkyQuestHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0/0"/>
                    </Grid>
                </Expander.Header>
                <TabControl x:Name="SkyQuestTabs" Margin="0,2,0,0"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextBrush}">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Padding" Value="7,4"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PopupBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled">
                                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                                </ScrollViewer>
                                <Border Grid.Row="1" Background="{DynamicResource PopupBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="0,0,4,4" Padding="6">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>
            </Expander>

            <Expander x:Name="TrackedSection" Style="{StaticResource Section}" Visibility="Collapsed">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F3AF; Watch" FontSize="13"/>
                        <TextBlock x:Name="TrackedHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0"/>
                    </Grid>
                </Expander.Header>
                <StackPanel x:Name="TrackedPanel"/>
            </Expander>

            <Expander x:Name="MoneySection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F4B0; Money" FontSize="13"/>
                        <TextBlock x:Name="MoneyHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0c"/>
                        <ToggleButton x:Name="StarMoney" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="money" Click="OnStarChanged" ToolTip="Show money in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <TextBlock x:Name="MoneySummary" Style="{StaticResource Dim}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SoldLabel" Text="Sold to merchants" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="SoldList" Margin="0,2,0,0"/>
                </StackPanel>
            </Expander>

            <Expander x:Name="ProgressSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F4C8; Progress" FontSize="13"/>
                        <TextBlock x:Name="ProgressHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0% xp"/>
                        <ToggleButton x:Name="StarXp" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="xp" Click="OnStarChanged" ToolTip="Show XP in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <TextBlock x:Name="ProgressSummary" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <TextBlock Text="Skill-ups" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <ItemsControl x:Name="SkillList" Margin="0,2,0,0"/>
                    <!-- Character state, not session activity: what the log's whole history
                         (plus the durable ledger) says this character owns. -->
                    <TextBlock x:Name="AaAbilitiesLabel" Text="AA abilities" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                    <ItemsControl x:Name="AaAbilityList" Margin="0,2,0,0"/>
                </StackPanel>
            </Expander>

            <Expander x:Name="FactionSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x2696;&#xFE0F; Faction" FontSize="13"/>
                        <TextBlock x:Name="FactionHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="—"/>
                    </Grid>
                </Expander.Header>
                <ItemsControl x:Name="FactionList"/>
            </Expander>

            <Expander x:Name="MiscSection" Style="{StaticResource Section}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F5FA;&#xFE0F; Travels &amp; Deaths" FontSize="13"/>
                        <TextBlock x:Name="MiscHeader" Grid.Column="1" Style="{StaticResource StatValue}" Text="0 deaths"/>
                        <ToggleButton x:Name="StarDeaths" Grid.Column="2" Style="{StaticResource StarToggle}"
                                      Tag="deaths" Click="OnStarChanged" ToolTip="Show deaths in mini dashboard"/>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <TextBlock Text="Deaths" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadBrush}"/>
                    <ItemsControl x:Name="DeathList" Margin="0,2,0,4"/>
                    <TextBlock Text="Zones visited" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <ItemsControl x:Name="ZoneList" Margin="0,2,0,4"/>
                    <TextBlock x:Name="MarkersLabel" Text="Camp markers" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="MarkerList" Margin="0,2,0,0"/>
                </StackPanel>
            </Expander>
            </StackPanel>
            </ScrollViewer>

            </StackPanel>
        </StackPanel>
    </Border>

    <!-- Bottom-right resize grip. Only visible in full mode — the mini dashboard has its
         own compact width and isn't meant to be stretched. -->
    <Thumb x:Name="ResizeGrip" Width="14" Height="14" Margin="0,0,2,2"
           HorizontalAlignment="Right" VerticalAlignment="Bottom"
           Cursor="SizeNWSE" ToolTip="Drag to resize (scales text and everything else with it)"
           DragStarted="OnResizeGripStarted" DragDelta="OnResizeGripDelta">
        <Thumb.Template>
            <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
        </Thumb.Template>
    </Thumb>
    </Grid>
</Window>
