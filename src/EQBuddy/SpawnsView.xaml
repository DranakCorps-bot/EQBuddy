<UserControl x:Class="EQBuddy.SpawnsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Gate 3 of the UI/UX rework (docs/DesignSystem.md §10, §11.5). The Gate 1 audit
         used THIS window as its worked example, and its three findings were one defect:
         a countdown that is only a string has no state.

           · the countdown and the editable duration carried near-identical weight, so a
             glanceable value and a configuration field read as two equal columns;
           · every row showed two empty input boxes as visible rectangles — a status
             surface wearing an editing surface's chrome, permanently;
           · a row with no timer left the countdown blank, so UNKNOWN and NOTHING looked
             the same;
           · and there was no progress toward respawn anywhere, so "due in 4:21" and
             "due in 18:31" looked equally urgent.

         All four are answered by UI.Shared/TimerView, which gives a timer a STATE that
         decides its words, its colour and whether it has a bar at all.

         Functionality is unchanged. Per §8c the duration stays FREE TEXT — SpawnDurationText
         parses 5m, 90s, 22m and 3d 12h, and the numeric spinner the mockup drew would
         regress week-long raid targets. What it gains is the placeholder guidance the
         mockup added, which is a real improvement.

         No literal sizes here: every number resolves out of the token dictionary.

         Lifted out of SpawnsWindow.xaml for World PR 1 (docs/Themes.md theme 6) — the
         whole bordered panel, chrome and content together (the window is borderless and
         hand-drawn, so unlike Map/Travel there is no clean chrome/content seam at the
         XAML level). SpawnsWindow becomes a thin Window that hosts this and owns only
         what a literal OS window owns: sizing, position, DragMove, Close. -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource CornerPanel}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="TitleBar" Margin="{DynamicResource PadCard}">
            <StackPanel x:Name="TitleRow" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Button x:Name="CloseBtn" Style="{StaticResource EqIconButton}"
                    ToolTip="Hide — the window returns when the next named dies (turn tracking off in Options or the right-click menu)"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </Grid>

        <Grid Grid.Row="1" Margin="{DynamicResource PadCard}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ZoneCombo" Grid.Column="0"
                      FontSize="{DynamicResource FontBody}"
                      Height="{DynamicResource ControlHeight}"
                      SelectionChanged="OnZonePicked"
                      ToolTip="Which zone's named to show"/>
            <CheckBox x:Name="FollowCheck" Grid.Column="1" Margin="{DynamicResource GapS}"
                      VerticalAlignment="Center"
                      Content="Follow" FontSize="{DynamicResource FontCaption}"
                      Checked="OnFollowChanged" Unchecked="OnFollowChanged"
                      ToolTip="Switch to whatever zone the log says you are in"/>
        </Grid>

        <!-- Column headers. The mockup's, and adopted wholesale: five unlabelled columns
             of boxes and glyphs is a puzzle the first time and a memory test after that. -->
        <Grid x:Name="HeaderRow" Grid.Row="2" Margin="{DynamicResource PadCard}"/>

        <ScrollViewer x:Name="BodyScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel x:Name="RowsPanel" Margin="{DynamicResource PadCard}"/>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Margin="{DynamicResource PadCard}">
            <!-- The help text as an INFO CALLOUT rather than a grey paragraph (the
                 mockup's improvement): it is the accuracy contract for this window —
                 our numbers came from community sources and yours win — and a paragraph
                 at 65% opacity is how that stopped being read. -->
            <Border x:Name="HelpCallout" Background="{DynamicResource RaisedBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource CornerCard}"
                    Padding="{DynamicResource PadRow}"
                    Margin="{DynamicResource StackM}"/>

            <TextBlock Text="Add a named this zone's catalog doesn't have"
                       Style="{StaticResource SectionLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Labelled fields, per the mockup. Two unlabelled boxes and a "+" made
                     the second one unguessable — and it is the one with syntax. -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Name" FontSize="{DynamicResource FontMetadata}"
                               Foreground="{DynamicResource DimBrush}"/>
                    <TextBox x:Name="AddNameBox" Style="{StaticResource InputBox}"
                             FontSize="{DynamicResource FontCaption}"
                             Height="{DynamicResource ControlHeight}"
                             VerticalContentAlignment="Center"
                             ToolTip="Add a named the catalog doesn't know (this zone)"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="{DynamicResource GapS}">
                    <TextBlock Text="Respawn" FontSize="{DynamicResource FontMetadata}"
                               Foreground="{DynamicResource DimBrush}"/>
                    <TextBox x:Name="AddDurationBox" Style="{StaticResource InputBox}"
                             FontSize="{DynamicResource FontCaption}"
                             Height="{DynamicResource ControlHeight}"
                             VerticalContentAlignment="Center"
                             ToolTip="22 (minutes), 90s, 12h, 3d, 3d 12h, 6:40"/>
                </StackPanel>
                <Button x:Name="AddBtn" Grid.Column="2" Content="Add"
                        Margin="{DynamicResource GapS}"
                        VerticalAlignment="Bottom"
                        Height="{DynamicResource ControlHeight}"
                        FontSize="{DynamicResource FontCaption}"
                        Style="{StaticResource ActionButton}"
                        ToolTip="Add this named to the zone" Click="OnAddCustom"/>
            </Grid>
        </StackPanel>
      </Grid>
    </Border>
</UserControl>
