<Window x:Class="EQBuddy.QuestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQBuddy Quest Tracker" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        Width="880" WindowStartupLocation="Manual">
    <!-- Gate 2 of the UI/UX rework (docs/DesignSystem.md). Same FUNCTIONS as the card
         stack this replaces — nothing was added, removed or rewired — laid out as
         LIST + DETAIL instead of a column of self-contained cards.

         Why the shape changed: every card carried its own rewards, meta line, item rows
         and five controls, so scanning fifty of them meant reading fifty paragraphs to
         find the one that is ready. The list answers "which one" and the detail pane
         answers "what about it", which is the order a player actually asks them in.

         Nothing below carries a literal size, radius or spacing value: every number
         resolves out of the token dictionary DesignSystem.Tokens() composes from
         EQBuddy.UI.Shared.DesignTokens, which is also what the Avalonia window styles
         itself from. DesignRatchetTests fails the build if a literal reappears. -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource CornerPanel}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title row. The icon is a vector (DesignSystem.Icon), not the map emoji it
             was: emoji render at a size and weight the app does not control, and boxed
             outright in Wine prefixes (#148, #166). -->
        <Grid Grid.Row="0" Margin="{DynamicResource PadCard}">
            <StackPanel x:Name="TitleRow" Orientation="Horizontal" VerticalAlignment="Center"/>
            <Button x:Name="CloseBtn" Style="{StaticResource EqIconButton}" ToolTip="Close"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="{DynamicResource PadCard}">
            <!-- Top-level surfaces (David, 2026-08-15): one window for all quest work,
                 so the main widget stops carrying Epic and Sky as separate lines.
                 Labels and order come from Core's QuestSurface so mobile shows the
                 same three in the same order. -->
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="{DynamicResource StackS}"/>

            <!-- The search box now spans the header, which is the whole point: it was
                 "so compressed I missed it" (David, 2026-08-15) sharing a row with a
                 button. The placeholder is the feature — it names what the box accepts,
                 so the reward-first way in is discoverable without a tooltip. -->
            <Grid Margin="{DynamicResource StackS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="FilterBox" Style="{StaticResource EqSearchBox}"
                             TextChanged="OnFilterChanged"
                             ToolTip="Search the whole catalog by anything you know — the reward you want (&quot;Wakizashi of the Frozen Skies&quot;), a turn-in item, the quest name, the quest giver, a zone. Search ignores the class/era/state filters. Pin a result to track it."/>
                    <StackPanel x:Name="FilterHint" Orientation="Horizontal"
                                IsHitTestVisible="False" VerticalAlignment="Center"
                                Margin="{DynamicResource PadControl}" Opacity="0.55"/>
                </Grid>
                <Button x:Name="CopyInvBtn" Grid.Column="1"
                        Style="{StaticResource ActionButton}"
                        FontSize="{DynamicResource FontCaption}"
                        Margin="{DynamicResource GapS}" Click="OnCopyInventoryCmd"
                        ToolTip="Copy /outputfile inventory — paste it in the game's chat, and EQBuddy reads what your bags and bank already hold. The held tab then shows every quest you could turn in right now."/>
            </Grid>

            <Grid x:Name="FilterRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="EraCombo" Grid.Column="0" Width="104"
                          FontSize="{DynamicResource FontCaption}"
                          Height="{DynamicResource ControlHeight}"
                          SelectionChanged="OnEraChanged"
                          ToolTip="Hide quests from later eras than the world has (unmarked quests always show)"/>
                <!-- State filter (Reddit ask, 2026-08-11): every tab and search can
                     narrow to open / ready / completed. -->
                <ComboBox x:Name="StateCombo" Grid.Column="1" Width="86"
                          FontSize="{DynamicResource FontCaption}"
                          Height="{DynamicResource ControlHeight}"
                          Margin="{DynamicResource GapS}" SelectionChanged="OnStateChanged"
                          ToolTip="Any state · open (not yet completed) · ready (turn-ins in hand) · done (marked completed)"/>
                <!-- Multiclass filter (Legends: up to 3 active classes): a checkbox
                     popup, selection remembered per character. -->
                <Button x:Name="ClassBtn" Grid.Column="2" Content="Any class"
                        Style="{StaticResource ActionButton}"
                        FontSize="{DynamicResource FontCaption}"
                        Height="{DynamicResource ControlHeight}"
                        Margin="{DynamicResource GapS}" Click="OnClassBtn"
                        ToolTip="Pick your class(es) — quests any of them can do stay visible"/>
                <!-- Followed the Epic card here when the widget's two quest cards became
                     one launcher (2026-08-16). It is an Epic-tab lens, so it shows on
                     that tab only — the same rule the era/state combos follow. -->
                <CheckBox x:Name="EpicClassicOnlyCheck" Grid.Column="3"
                          VerticalAlignment="Center" Margin="{DynamicResource GapS}"
                          FontSize="{DynamicResource FontCaption}"
                          Visibility="Collapsed"
                          Checked="OnEpicClassicOnlyToggled" Unchecked="OnEpicClassicOnlyToggled"
                          Content="Classic-doable only"
                          Foreground="{DynamicResource DimBrush}"
                          ToolTip="Show only the Epic steps that can be finished in the classic era"/>
                <!-- The Sky tab's own lens, same rule and same column as the Epic one above:
                     a tab-scoped view choice belongs on the tab, not in Options. -->
                <CheckBox x:Name="SkyIslandRepeatCheck" Grid.Column="3"
                          VerticalAlignment="Center" Margin="{DynamicResource GapS}"
                          FontSize="{DynamicResource FontCaption}"
                          Visibility="Collapsed"
                          Checked="OnSkyIslandRepeatToggled" Unchecked="OnSkyIslandRepeatToggled"
                          Content="Repeat multi-island steps"
                          Foreground="{DynamicResource DimBrush}"
                          ToolTip="Some Sky pieces drop on several islands. Off: each is listed once, under &quot;Several islands&quot;. On: each appears under every island it drops on, so one island's list is complete — the same step then shows more than once."/>
                <Popup x:Name="ClassPopup" PlacementTarget="{Binding ElementName=ClassBtn}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource PopupBrush}"
                            CornerRadius="{DynamicResource CornerCard}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="{DynamicResource PadCard}">
                        <StackPanel x:Name="ClassChecks"/>
                    </Border>
                </Popup>
                <!-- mine = your items + pins · zone = doable where you're standing ·
                     held = what your bags could turn in · done = the trophy shelf ·
                     all = the whole catalog. Built in code as chips, the same primitive
                     as the tabs and the class lens, so the three strips agree. -->
                <StackPanel x:Name="ModeStrip" Grid.Column="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Class lens, on EVERY tab (David, 2026-08-15). A 486-row Epic list is
                 exactly where narrowing to one of your three classes matters most.
                 Wraps, because the strip lists whatever the class picker holds and that
                 can be all sixteen: a fixed-width window clipped it at NEC (#184). -->
            <WrapPanel x:Name="ClassStrip" Margin="{DynamicResource StackXs}"/>
        </StackPanel>

        <!-- LIST + DETAIL. The list answers "which quest", the pane answers "what about
             it". On the Epic and Sky tabs there is nothing to select — those are fixed
             checklists, not a catalog — so the detail column collapses and the list
             takes the whole width. -->
        <Grid Grid.Row="2" Margin="{DynamicResource PadCard}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MasterColumn" Width="400"/>
                <ColumnDefinition x:Name="DetailColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <!-- What the window exists to answer, above the fold and before the
                     first row is read. Hidden entirely when nothing is ready: "0 quests
                     ready" reads as a fault in the tracker rather than an ordinary
                     afternoon. -->
                <StackPanel x:Name="SummaryRow" DockPanel.Dock="Top" Orientation="Horizontal"
                            Margin="{DynamicResource StackS}" Visibility="Collapsed"/>
                <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="QuestsPanel" Margin="{DynamicResource GapS}"/>
                </ScrollViewer>
            </DockPanel>

            <Border x:Name="DetailCard" Grid.Column="1"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource CornerCard}"
                    Margin="{DynamicResource GapS}">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                              Padding="{DynamicResource PadCard}">
                    <StackPanel x:Name="DetailPane"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Undo (#184, bjstrange: "An errant click will clear an item without any real
             feedback. I've mis-clicked on 3 items and now have to figure out what was
             checked before"). A tick is one click and saves immediately, so the only
             honest answer is to say what just changed and offer it back. -->
        <Border x:Name="UndoBar" Grid.Row="3" Visibility="Collapsed"
                Margin="{DynamicResource PadCard}"
                Background="{DynamicResource PopupBrush}"
                CornerRadius="{DynamicResource CornerCard}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="{DynamicResource PadRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UndoText" Grid.Column="0"
                           FontSize="{DynamicResource FontBodySecondary}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
                <Button x:Name="UndoBtn" Grid.Column="1"
                        Style="{StaticResource ActionButton}"
                        FontSize="{DynamicResource FontCaption}"
                        Margin="{DynamicResource GapS}" Click="OnUndo"
                        ToolTip="Put the last tick back the way it was (Ctrl+Z)"/>
            </Grid>
        </Border>

        <!-- The accuracy contract, said plainly (David, 2026-08-11): we mirror the wiki,
             we're exactly as right as it is, and the door to fixing BOTH swings from
             here. Metadata weight — present and readable, never competing with a row. -->
        <StackPanel Grid.Row="4" Margin="{DynamicResource PadCard}">
            <TextBlock x:Name="CountsNote" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontMetadata}"
                       Foreground="{DynamicResource DimBrush}"
                       Text="Counts what you loot, minus what the log sees leave (sales, merges, destroys), plus whatever scan bags reads from your bags and bank. Hand-ins aren't in the log — use the detail pane's turn-in button, or right-click an item row to clear it."/>
            <TextBlock x:Name="WikiNote" TextWrapping="Wrap"
                       Margin="{DynamicResource StackXs}"
                       FontSize="{DynamicResource FontMetadata}"
                       Foreground="{DynamicResource DimBrush}"
                       Text="Every quest here mirrors eqlwiki.com — verified item-for-item against it, so EQBuddy is exactly as accurate as the wiki is today. Spot something wrong? The report control on the detail pane tells us; fixing the wiki page itself fixes it for everyone (the catalog re-harvests weekly). Your own discoveries flow back too: Drops by Creature marks wiki-unknown drops in red with a paste-ready page edit."/>
        </StackPanel>
      </Grid>
    </Border>
</Window>
