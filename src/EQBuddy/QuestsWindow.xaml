<Window x:Class="EQBuddy.QuestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQBuddy Quest Tracker" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="530" WindowStartupLocation="Manual">
    <!-- Same chrome family as Spawns: the body scrolls, the title row stays reachable.
         Cards are built in code (BuildCards) — one per quest that overlaps the ledger. -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,6">
            <TextBlock x:Name="TitleText" Text="🗺 Quest Tracker" FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource AccentBrush}"/>
            <Button Style="{StaticResource IconButton}" Content="&#x2715;" ToolTip="Close"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </Grid>

        <!-- One way in (David, 2026-08-15): search the catalog by whatever you happen to
             know — the reward you want, an item in your bags, the quest's name, the NPC.
             The old "+ I have this" item/qty/button row is gone: declaring pre-EQBuddy
             inventory by hand is what /outputfile inventory does properly, and the ⧉
             beside the box hands you that command. -->
        <StackPanel Grid.Row="1" Margin="16,0,16,4">
            <!-- Top-level surfaces (David, 2026-08-15): one window for all quest work,
                 so the main widget stops carrying Epic and Sky as separate lines.
                 Labels and order come from Core's QuestSurface so mobile shows the
                 same three in the same order. -->
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="0,0,0,7"/>
            <!-- Class lens, on EVERY tab (David, 2026-08-15). A 486-row Epic list is
                 exactly where narrowing to one of your three classes matters most, and
                 the old filter row was hidden on those tabs entirely. -->
            <!-- Wraps, because the strip lists whatever the ⚙ picker holds and that can
                 be all sixteen: a fixed-width window clipped it at NEC (#184). -->
            <WrapPanel x:Name="ClassStrip" Margin="0,0,0,7"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- The placeholder is the feature (David, 2026-08-15: "it exists but is
                     so compressed I missed it"). An empty box teaches nothing; this one
                     names what it accepts, so the reward-first way in is discoverable
                     without a tooltip nobody hovers. -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="FilterBox" Style="{StaticResource InputBox}"
                             FontSize="13" Padding="6,4"
                             TextChanged="OnFilterChanged"
                             ToolTip="Search the whole catalog by anything you know — the reward you want (&quot;Wakizashi of the Frozen Skies&quot;), a turn-in item, the quest name, the quest giver, a zone. Search ignores the class/era/state filters. Pin 📌 a result to track it."/>
                    <TextBlock x:Name="FilterHint" IsHitTestVisible="False"
                               Text="🔍  Search a reward, item, quest, or NPC…"
                               FontSize="13" Margin="10,0,0,0" Opacity="0.55"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                </Grid>
                <Button x:Name="CopyInvBtn" Grid.Column="1" Content="⧉ scan bags"
                        Style="{StaticResource ActionButton}" FontSize="11" Padding="8,2"
                        Margin="6,0,0,0" Click="OnCopyInventoryCmd"
                        ToolTip="Copy /outputfile inventory — paste it in the game's chat, and EQBuddy reads what your bags and bank already hold. The held tab then shows every quest you could turn in right now."/>
            </Grid>
            <Grid x:Name="FilterRow" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="EraCombo" Grid.Column="0" Width="104" FontSize="11"
                          SelectionChanged="OnEraChanged"
                          ToolTip="Hide quests from later eras than the world has (unmarked quests always show)"/>
                <!-- State filter (Reddit ask, 2026-08-11): every tab and search can
                     narrow to open / ready / completed. -->
                <ComboBox x:Name="StateCombo" Grid.Column="1" Width="86" FontSize="11"
                          Margin="6,0,0,0" SelectionChanged="OnStateChanged"
                          ToolTip="Any state · open (not yet completed) · ready (turn-ins in hand) · done (marked completed)"/>
                <!-- Multiclass filter (Legends: up to 3 active classes): a checkbox
                     popup, selection remembered per character. -->
                <Button x:Name="ClassBtn" Grid.Column="2" Content="Any class"
                        Style="{StaticResource ActionButton}" FontSize="11" Padding="8,2"
                        Margin="6,0,0,0" Click="OnClassBtn"
                        ToolTip="Pick your class(es) — quests any of them can do stay visible"/>
                <!-- Followed the Epic card here when the widget's two quest cards became
                     one launcher (2026-08-16). It is an Epic-tab lens, so it shows on
                     that tab only — the same rule the era/state combos follow on the
                     General tab. Losing it entirely would have stranded a setting the
                     projection still honors for EQBuddy Mobile. -->
                <CheckBox x:Name="EpicClassicOnlyCheck" Grid.Column="3"
                          VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                          Visibility="Collapsed"
                          Checked="OnEpicClassicOnlyToggled" Unchecked="OnEpicClassicOnlyToggled"
                          Content="Classic-doable only"
                          Foreground="{DynamicResource DimBrush}"
                          ToolTip="Show only the Epic steps that can be finished in the classic era"/>
                <Popup x:Name="ClassPopup" PlacementTarget="{Binding ElementName=ClassBtn}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource PopupBrush}" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="10,8">
                        <StackPanel x:Name="ClassChecks"/>
                    </Border>
                </Popup>
                <!-- mine = your items + 📌 pins · zone = doable where you're standing ·
                     all = the whole catalog -->
                <Border x:Name="ModeStrip" Grid.Column="3" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Margin="6,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" Padding="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ModeMine" Text="mine" Tag="mine" FontSize="10.5"
                                   Padding="7,1" Cursor="Hand" MouseLeftButtonDown="OnModeClick"
                                   ToolTip="Quests matching your items and pins"/>
                        <TextBlock x:Name="ModeZone" Text="zone" Tag="zone" FontSize="10.5"
                                   Padding="7,1" Cursor="Hand" MouseLeftButtonDown="OnModeClick"
                                   ToolTip="Everything you can work on in the zone you're in"/>
                        <TextBlock x:Name="ModeHeld" Text="held" Tag="held" FontSize="10.5"
                                   Padding="7,1" Cursor="Hand" MouseLeftButtonDown="OnModeClick"
                                   ToolTip="Quests you could turn in with what your bags already hold — from the game's /outputfile inventory dump. In game, type /outputfile inventory, and this tab reads the file the game writes."/>
                        <TextBlock x:Name="ModeDone" Text="done" Tag="done" FontSize="10.5"
                                   Padding="7,1" Cursor="Hand" MouseLeftButtonDown="OnModeClick"
                                   ToolTip="Quests you've marked completed — every card has a ✓ done control, so returning players can check off history"/>
                        <TextBlock x:Name="ModeAll" Text="all" Tag="all" FontSize="10.5"
                                   Padding="7,1" Cursor="Hand" MouseLeftButtonDown="OnModeClick"
                                   ToolTip="The whole quest catalog"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <ScrollViewer x:Name="BodyScroll" Grid.Row="2" Margin="10,2,4,0"
                      VerticalScrollBarVisibility="Auto" Padding="6,0">
            <StackPanel x:Name="QuestsPanel" Margin="0,0,6,0"/>
        </ScrollViewer>

        <!-- Undo (#184, bjstrange: "An errant click will clear an item without any real
             feedback. I've mis-clicked on 3 items and now have to figure out what was
             checked before"). A tick is one click and saves immediately, so the only
             honest answer is to say what just changed and offer it back. Hidden until
             there is something to undo. -->
        <Border x:Name="UndoBar" Grid.Row="3" Visibility="Collapsed" Margin="16,4,16,0"
                Background="{DynamicResource PopupBrush}" CornerRadius="6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UndoText" Grid.Column="0" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
                <Button x:Name="UndoBtn" Grid.Column="1" Content="↶ undo"
                        Style="{StaticResource ActionButton}" FontSize="11" Padding="8,2"
                        Margin="8,0,0,0" Click="OnUndo"
                        ToolTip="Put the last tick back the way it was (Ctrl+Z)"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="16,8,16,14">
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Text="Counts what you loot, minus what the log sees leave (sales, merges, destroys), plus whatever ⧉ scan bags reads from your bags and bank. Hand-ins aren't in the log — click ✔ ready when you turn in, or right-click an item row to clear it. Click a quest name for the full wiki walkthrough."/>
            <!-- The accuracy contract, said plainly (David, 2026-08-11): we mirror the
                 wiki, we're exactly as right as it is, and the door to fixing BOTH
                 swings from here. -->
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Every quest here mirrors eqlwiki.com — verified item-for-item against it, so EQBuddy is exactly as accurate as the wiki is today. Spot something wrong? ⚑ on the card tells us; fixing the wiki page itself fixes it for everyone (the catalog re-harvests weekly). Your own discoveries flow back too: Drops by Creature marks wiki-unknown drops in red with a paste-ready page edit."/>
        </StackPanel>
      </Grid>
    </Border>
</Window>
