<Project Sdk="Microsoft.NET.Sdk">

  <!-- The second-screen server: a phone on the same Wi-Fi scans a QR code and its
       browser becomes a live companion display. LAN-only, off by default, token-gated;
       see SECURITY.md's "Second screen" section for the full trust story.

       Server library decision (2026-08-14 spike): hand-rolled TcpListener micro-server,
       NOT EmbedIO and NOT ASP.NET Core. ASP.NET Core is framework bloat for two routes;
       HttpListener rides http.sys and its URL-ACL admin friction; EmbedIO (MIT) would
       fit but is dormant upstream and drags Unosquare.Swan along — and this repo ships
       unsigned to family machines where every extra foreign DLL is another Defender
       false-positive lottery ticket (see the Wacatac history). The needs are two
       routes and RFC 6455 server frames: small enough to own, and owned code here is
       covered by real-socket tests (CompanionServerTests).

       No WPF references, ever — ArchitectureTests.SharedLayersReferenceNoUiToolkit
       enforces it. The toolkit-free test project has to be able to host this server
       unchanged (the Avalonia lane was the other host until E-2c). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EQBuddy.Companion</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQBuddy.Core\EQBuddy.Core.csproj" />
    <!-- UI.Shared is framework-neutral presentation (palettes, checklist grouping,
         breakdown rows) — the phone renders the same views the desktop cards do, so
         it projects from the same helpers instead of growing a second copy. -->
    <ProjectReference Include="..\EQBuddy.UI.Shared\EQBuddy.UI.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The phone page, embedded so the server binary is self-contained. -->
    <EmbeddedResource Include="Web\index.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- QrEncoder's internals (version tables, Reed-Solomon, format bits) are only
         provable from tests; nothing else touches them. -->
    <InternalsVisibleTo Include="EQBuddy.Tests" />
  </ItemGroup>

</Project>
