<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EQBuddy.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Direct reference overriding the transitive 2.1.11, which carries the
         high-severity GHSA-2m69-gcr7-jv3q (NU1903 on every release build).
         Drop this once Microsoft.Data.Sqlite itself depends on >= 2.1.12. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Log-folder detection picks between candidate installs, which is only testable by
         building real directory trees and reaching the selector directly. Test-only:
         nothing else references this. -->
    <InternalsVisibleTo Include="EQBuddy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\SpawnCatalog.json" />
    <EmbeddedResource Include="Data\FadeMessages.json" />
    <EmbeddedResource Include="Data\WhatsNew.json" />
    <EmbeddedResource Include="Data\MezSpells.json" />
    <EmbeddedResource Include="Data\AaCatalog.json" />
    <EmbeddedResource Include="Data\CcSpells.json" />
    <EmbeddedResource Include="Data\RegenSpells.json" />
    <EmbeddedResource Include="Data\QuestCatalog.json" />
    <EmbeddedResource Include="Data\ZoneGraph.json" />
  </ItemGroup>

</Project>
